<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <Authors>StealthDesk</Authors>
    <Copyright>©️ $([System.DateTime]::Now.Year) StealthDesk</Copyright>
    <RepositoryUrl></RepositoryUrl>
    <PackageProjectUrl></PackageProjectUrl>
    <Company>StealthDesk</Company>
    <Description></Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <WindowsTfm>net10.0-windows8.0</WindowsTfm>
    <MacTfm>net10.0-macos</MacTfm>
    <MacMinVersion>26.5</MacMinVersion>
    <LinuxTfm>net10.0</LinuxTfm>
  </PropertyGroup>

  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);SD0001;</WarningsNotAsErrors>
    <!-- A ProjectReference to a path that doesn't exist (MSB9008) must fail the build, not just warn. -->
    <MSBuildWarningsAsErrors>$(MSBuildWarningsAsErrors);MSB9008</MSBuildWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup
    Condition="$(RuntimeIdentifier.StartsWith('win')) OR ('$(RuntimeIdentifier)' == '' AND $([System.OperatingSystem]::IsWindows()))">
    <XplatTarget>$(WindowsTfm)</XplatTarget>
    <DefineConstants>$(DefineConstants);SYS_WINDOWS</DefineConstants>
    <IsWindows>true</IsWindows>
  </PropertyGroup>

  <PropertyGroup
    Condition="$(RuntimeIdentifier.StartsWith('osx')) OR ('$(RuntimeIdentifier)' == '' AND $([System.OperatingSystem]::IsMacOS()))">
    <XplatTarget>$(MacTfm)</XplatTarget>
    <DefineConstants>$(DefineConstants);SYS_MACOS;SYS_UNIX</DefineConstants>
    <IsMacOS>true</IsMacOS>
    <IsUnix>true</IsUnix>
  </PropertyGroup>

  <PropertyGroup
    Condition="$(RuntimeIdentifier.StartsWith('linux')) OR ('$(RuntimeIdentifier)' == '' AND $([System.OperatingSystem]::IsLinux()))">
    <XplatTarget>$(LinuxTfm)</XplatTarget>
    <DefineConstants>$(DefineConstants);SYS_LINUX;SYS_UNIX</DefineConstants>
    <IsLinux>true</IsLinux>
    <IsUnix>true</IsUnix>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsNuGetPackage)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>