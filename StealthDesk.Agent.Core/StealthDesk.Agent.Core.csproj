<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Its built-in modules are carried inside the agent instead of next to it (see PowerShellModules). -->
    <PackageReference Include="Microsoft.PowerShell.SDK" GeneratePathProperty="true" ExcludeAssets="contentFiles" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PkgMicrosoft_PowerShell_SDK)/contentFiles/any/any/runtimes/win/lib/net10.0/Modules/**/*"
                      LogicalName="PowerShellModules/win/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(PkgMicrosoft_PowerShell_SDK)/contentFiles/any/any/runtimes/unix/lib/net10.0/Modules/**/*"
                      LogicalName="PowerShellModules/unix/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\shared\StealthDesk.Branding\StealthDesk.Branding.csproj" />
    <ProjectReference Include="..\shared\StealthDesk.Contracts\StealthDesk.Contracts.csproj" />
    <ProjectReference Include="..\shared\StealthDesk.Core\StealthDesk.Core.csproj" />
    <ProjectReference Include="..\shared\StealthDesk.Hosting\StealthDesk.Hosting.csproj" />
    <ProjectReference Include="..\shared\StealthDesk.Ipc\StealthDesk.Ipc.csproj" />
    <ProjectReference Include="..\shared\StealthDesk.Observability\StealthDesk.Observability.csproj" />
    <ProjectReference Include="..\shared\StealthDesk.Realtime\StealthDesk.Realtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="StealthDesk.Agent.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
