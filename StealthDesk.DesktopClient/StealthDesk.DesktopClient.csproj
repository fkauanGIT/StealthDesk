<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- No console window: it runs in sessions where nobody asked for it. -->
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="NativeMethods.txt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\shared\StealthDesk.Branding\StealthDesk.Branding.csproj" />
    <ProjectReference Include="..\shared\StealthDesk.Contracts\StealthDesk.Contracts.csproj" />
    <ProjectReference Include="..\shared\StealthDesk.Hosting\StealthDesk.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="StealthDesk.Agent.Tests" />
  </ItemGroup>
</Project>
