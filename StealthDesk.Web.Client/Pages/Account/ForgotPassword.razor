@page "/account/forgot-password"
@inject AccountApi Accounts

<PageTitle>Forgot password · StealthDesk</PageTitle>

<header class="sd-auth-header">
    <h1 class="sd-auth-title">Forgot your password?</h1>
    <p class="sd-auth-subtitle">Enter your email and we'll send you a link to choose a new one.</p>
</header>

@if (sent)
{
    @* The same answer whether or not the account exists, so the page can't be used to find accounts. *@
    <SdAlert Tone="Tone.Info">If an account with a confirmed email uses @email, a reset link is on its way.</SdAlert>
}
else
{
    @if (error is not null)
    {
        <SdAlert>@error</SdAlert>
    }

    <form class="sd-form" @onsubmit="SubmitAsync">
        <SdTextField Label="Email" Type="email" Autocomplete="username" @bind-Value="email" />
        <SdButton Type="submit" Block="true" Disabled="busy">@(busy ? "Sending..." : "Send reset link")</SdButton>
    </form>
}

<p class="sd-auth-footer"><a href="account/sign-in">Back to sign in</a></p>

@code {
    private string? email;
    private bool busy;
    private bool sent;
    private string? error;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            error = "Enter your email address.";
            return;
        }

        busy = true;
        var result = await Accounts.ForgotPasswordAsync(email.Trim());
        busy = false;
        sent = result.Succeeded;
        error = result.Succeeded ? null : result.Error;
    }
}
