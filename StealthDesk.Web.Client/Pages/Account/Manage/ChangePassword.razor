@page "/account/manage/password"
@inject AccountApi Accounts
@inject SessionGuard Session
@inject NavigationManager Navigation

<PageTitle>Password · StealthDesk</PageTitle>

<SdCard Title="Change password">
    @if (profile is null)
    {
        <SdLoading Text="Loading..." />
    }
    else
    {
        @if (changed)
        {
            <SdAlert Tone="Tone.Info">Your password has been changed. Other browsers signed in to this account will need the new one.</SdAlert>
        }
        else if (error is not null)
        {
            <SdAlert>@error</SdAlert>
        }

        <form class="sd-form" @onsubmit="SubmitAsync">
            <SdTextField Label="Current password" Type="password" Autocomplete="current-password" @bind-Value="current" Error="@currentError" />
            <SdTextField Label="New password" Type="password" Autocomplete="new-password" @bind-Value="password" Error="@passwordError"
                         Hint="At least 8 characters, with upper and lower case letters and a digit." />
            <SdTextField Label="Confirm new password" Type="password" Autocomplete="new-password" @bind-Value="confirmation" Error="@confirmationError" />
            <div>
                <SdButton Type="submit" Disabled="busy">@(busy ? "Saving..." : "Update password")</SdButton>
            </div>
        </form>
    }
</SdCard>

@code {
    private AccountProfile? profile;
    private string? current;
    private string? password;
    private string? confirmation;
    private bool busy;
    private bool changed;
    private string? error;
    private string? currentError;
    private string? passwordError;
    private string? confirmationError;

    protected override async Task OnInitializedAsync()
    {
        profile = await Accounts.GetProfileAsync();
        if (profile is null)
        {
            Session.Expired();
        }
        else if (!profile.HasPassword)
        {
            Navigation.NavigateTo("account/manage/set-password", replace: true);
        }
    }

    private async Task SubmitAsync()
    {
        changed = false;
        error = currentError = passwordError = confirmationError = null;
        if (string.IsNullOrEmpty(current))
        {
            currentError = "Enter your current password.";
            return;
        }

        if (password != confirmation)
        {
            confirmationError = "The passwords don't match.";
            return;
        }

        busy = true;
        var result = await Accounts.ChangePasswordAsync(current, password ?? string.Empty);
        busy = false;

        if (result.Succeeded)
        {
            changed = true;
            current = password = confirmation = null;
            return;
        }

        currentError = FieldErrors.ForCurrentPassword(result);
        passwordError = FieldErrors.ForPassword(result);
        error = currentError is null && passwordError is null ? FieldErrors.Remaining(result) : null;
    }
}
