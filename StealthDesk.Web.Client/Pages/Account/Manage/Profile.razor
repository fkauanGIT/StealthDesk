@page "/account/manage"
@inject AccountApi Accounts
@inject SessionGuard Session

<PageTitle>Profile · StealthDesk</PageTitle>

<SdCard Title="Profile">
    @if (profile is null)
    {
        <SdLoading Text="Loading your profile..." />
    }
    else
    {
        @if (saved)
        {
            <SdAlert Tone="Tone.Info">Your profile has been updated.</SdAlert>
        }
        else if (error is not null)
        {
            <SdAlert>@error</SdAlert>
        }

        <form class="sd-form" @onsubmit="SaveAsync">
            <SdTextField Label="Email" Value="@profile.Email" Disabled="true" Hint="Change it on the Email page." />
            <SdTextField Label="User ID" Value="@profile.Id.ToString()" Disabled="true" Hint="Your unique user identifier." class="sd-input sd-mono" />
            <SdTextField Label="Phone number" Type="tel" Autocomplete="tel" @bind-Value="phoneNumber" Error="@phoneError" />
            <div>
                <SdButton Type="submit" Disabled="busy">@(busy ? "Saving..." : "Save")</SdButton>
            </div>
        </form>
    }
</SdCard>

<SdCard Title="Appearance">
    <p class="sd-muted">Auto follows your device's light or dark setting. Your choice is kept with your account, on any browser.</p>
    <ThemePicker />
</SdCard>

<SdCard Title="Remote control">
    <p class="sd-muted">The person at a device can be told, in a message on their screen, when you start a remote control session of it.</p>
    @if (profile is { NotifyOnRemoteControlOverriddenByTenant: true })
    {
        <p data-notify-preview><strong>@NotifyPreview</strong></p>
        <p class="sd-muted">Your tenant sets this for everyone; you can't change it here.</p>
    }
    else
    {
        <div data-notify-choice>
        <SdSegmented TValue="bool" Label="Tell the user at the device" Options="NotifyOptions" Value="notifyOnRemoteControl" ValueChanged="SaveNotifyAsync" />
        <p class="sd-field-hint" data-notify-preview>@NotifyPreview</p>
        </div>
        @if (notifyError is not null)
        {
            <SdAlert>@notifyError</SdAlert>
        }
    }
</SdCard>

@code {
    private static readonly IReadOnlyList<(bool, string)> NotifyOptions = [(true, "On"), (false, "Off")];

    private AccountProfile? profile;
    private string? phoneNumber;
    private bool busy;
    private bool saved;
    private string? error;
    private string? phoneError;
    private bool notifyOnRemoteControl;
    private string? notifyError;

    private string NotifyPreview => notifyOnRemoteControl
        ? "The user at the device is told when a session starts and ends."
        : "The user at the device isn't told about sessions.";

    protected override async Task OnInitializedAsync()
    {
        profile = await Accounts.GetProfileAsync();
        if (profile is null)
        {
            Session.Expired();
            return;
        }

        phoneNumber = profile.PhoneNumber;
        notifyOnRemoteControl = profile.NotifyOnRemoteControl;
    }

    private async Task SaveNotifyAsync(bool notify)
    {
        notifyError = null;
        var previous = notifyOnRemoteControl;
        notifyOnRemoteControl = notify;
        var result = await Accounts.SetNotifyOnRemoteControlAsync(notify);
        if (!result.Succeeded)
        {
            notifyOnRemoteControl = previous;
            notifyError = result.Error;
        }
    }

    private async Task SaveAsync()
    {
        busy = true;
        saved = false;
        error = phoneError = null;
        var result = await Accounts.UpdateProfileAsync(phoneNumber);
        busy = false;

        if (result.Succeeded)
        {
            saved = true;
            return;
        }

        phoneError = FieldErrors.ForPhoneNumber(result);
        error = phoneError is null ? FieldErrors.Remaining(result) : null;
    }
}
