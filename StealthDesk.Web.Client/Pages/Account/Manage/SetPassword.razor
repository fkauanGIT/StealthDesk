@page "/account/manage/set-password"
@inject AccountApi Accounts
@inject SessionGuard Session
@inject NavigationManager Navigation

<PageTitle>Set a password · StealthDesk</PageTitle>

<SdCard Title="Set a password">
    @if (profile is null)
    {
        <SdLoading Text="Loading..." />
    }
    else if (done)
    {
        <SdAlert Tone="Tone.Info">Your password has been set. You can now sign in with your email and this password.</SdAlert>
    }
    else
    {
        <p class="sd-muted">
            This account signs in only with an external login. Add a password to also sign in with your email.
        </p>

        @if (error is not null)
        {
            <SdAlert>@error</SdAlert>
        }

        <form class="sd-form" @onsubmit="SubmitAsync">
            <SdTextField Label="New password" Type="password" Autocomplete="new-password" @bind-Value="password" Error="@passwordError"
                         Hint="At least 8 characters, with upper and lower case letters and a digit." />
            <SdTextField Label="Confirm new password" Type="password" Autocomplete="new-password" @bind-Value="confirmation" Error="@confirmationError" />
            <div>
                <SdButton Type="submit" Disabled="busy">@(busy ? "Saving..." : "Set password")</SdButton>
            </div>
        </form>
    }
</SdCard>

@code {
    private AccountProfile? profile;
    private string? password;
    private string? confirmation;
    private bool busy;
    private bool done;
    private string? error;
    private string? passwordError;
    private string? confirmationError;

    protected override async Task OnInitializedAsync()
    {
        profile = await Accounts.GetProfileAsync();
        if (profile is null)
        {
            Session.Expired();
        }
        else if (profile.HasPassword)
        {
            Navigation.NavigateTo("account/manage/password", replace: true);
        }
    }

    private async Task SubmitAsync()
    {
        error = passwordError = confirmationError = null;
        if (password != confirmation)
        {
            confirmationError = "The passwords don't match.";
            return;
        }

        busy = true;
        var result = await Accounts.SetPasswordAsync(password ?? string.Empty);
        busy = false;

        if (result.Succeeded)
        {
            done = true;
            return;
        }

        passwordError = FieldErrors.ForPassword(result);
        error = passwordError is null ? FieldErrors.Remaining(result) : null;
    }
}
