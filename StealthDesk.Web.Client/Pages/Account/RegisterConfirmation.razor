@page "/account/register-confirmation"

<PageTitle>Check your email · StealthDesk</PageTitle>

<header class="sd-auth-header">
    <h1 class="sd-auth-title">Check your email</h1>
    <p class="sd-auth-subtitle">Your account is created.</p>
</header>

<SdAlert Tone="Tone.Info">
    We sent a confirmation link to @(Email ?? "your email address"). Open it to finish, then sign in.
</SdAlert>

<p class="sd-auth-footer">
    Nothing arrived? <a href="account/resend-confirmation?email=@Uri.EscapeDataString(Email ?? string.Empty)">Send it again</a>
</p>

@code {
    [SupplyParameterFromQuery]
    public string? Email { get; set; }
}
