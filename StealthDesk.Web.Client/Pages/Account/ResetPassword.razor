@page "/account/reset-password"
@inject AccountApi Accounts

<PageTitle>Choose a new password · StealthDesk</PageTitle>

<header class="sd-auth-header">
    <h1 class="sd-auth-title">Choose a new password</h1>
    <p class="sd-auth-subtitle">@Email</p>
</header>

@if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Code))
{
    <SdAlert>This link is incomplete. Open the link from the email again, or ask for a new one.</SdAlert>
    <p class="sd-auth-footer"><a href="account/forgot-password">Ask for a new link</a></p>
}
else if (done)
{
    <SdAlert Tone="Tone.Info">Your password is changed. You can sign in with it now.</SdAlert>
    <p class="sd-auth-footer"><a href="account/sign-in">Sign in</a></p>
}
else
{
    @if (error is not null)
    {
        <SdAlert>
            @error
            @if (expired)
            {
                <a href="account/forgot-password"> Ask for a new link</a>
            }
        </SdAlert>
    }

    <form class="sd-form" @onsubmit="SubmitAsync">
        <SdTextField Label="New password" Type="password" Autocomplete="new-password" @bind-Value="password" Error="@passwordError"
                     Hint="At least 8 characters, with upper and lower case letters and a digit." />
        <SdTextField Label="Confirm new password" Type="password" Autocomplete="new-password" @bind-Value="confirmation" Error="@confirmationError" />
        <SdButton Type="submit" Block="true" Disabled="busy">@(busy ? "Saving..." : "Change password")</SdButton>
    </form>
}

@code {
    private string? password;
    private string? confirmation;
    private bool busy;
    private bool done;
    private bool expired;
    private string? error;
    private string? passwordError;
    private string? confirmationError;

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Code { get; set; }

    private async Task SubmitAsync()
    {
        error = passwordError = confirmationError = null;
        if (password != confirmation)
        {
            confirmationError = "The passwords don't match.";
            return;
        }

        busy = true;
        var result = await Accounts.ResetPasswordAsync(Email!, Code!, password ?? string.Empty);
        busy = false;
        if (result.Succeeded)
        {
            done = true;
            return;
        }

        passwordError = FieldErrors.ForPassword(result);
        expired = result.FieldErrors?.ContainsKey("InvalidToken") == true;
        error = expired
            ? "This link is invalid, already used or expired."
            : passwordError is null ? FieldErrors.Remaining(result) : null;
    }
}
