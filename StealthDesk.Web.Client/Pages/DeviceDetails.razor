@page "/devices/{Id:guid}"
@attribute [Authorize]
@implements IDisposable
@inject DeviceStore Store
@inject ILiveUpdates Live
@inject IDeviceHub Hub

<PageTitle>@(device?.Name ?? "Device") · StealthDesk</PageTitle>

<a class="sd-back" href="">
    <SdIcon Name="IconName.Back" Size="16" />
    All devices
</a>

@if (lookup is null)
{
    <SdLoading Text="Loading device..." />
}
else if (lookup.IsNotFound)
{
    <SdEmptyState Title="Device not found">It may have been removed, or the link is wrong.</SdEmptyState>
}
else if (device is null)
{
    <SdAlert>Could not load the device. Check that the server is running.</SdAlert>
}
else
{
    <header class="sd-page-header">
        <div class="sd-device-icon"><SdIcon Name="IconName.Device" Size="26" /></div>
        <div>
            <h1 class="sd-page-title">@device.Name</h1>
            <p class="sd-muted">@Subtitle(device)</p>
            @if (canReadGroups)
            {
                <div class="sd-device-groups">
                    <span class="sd-device-groups" data-groups>
                        @foreach (var (id, name) in GroupNames(device))
                        {
                            <a class="sd-chip" href="device-groups/@id">@name</a>
                        }
                    </span>
                    @if (device.GroupIds.Count == 0)
                    {
                        <span class="sd-muted">In no group</span>
                    }
                    @if (canAssignGroups && groupNames.Count > 0)
                    {
                        <SdButton Variant="ButtonVariant.Ghost" OnClick="OpenGroups">Change groups</SdButton>
                    }
                </div>
            }
        </div>
        <DeviceStatus IsOnline="device.IsOnline" />
        @if (canUseTerminal)
        {
            <div class="sd-push sd-device-actions">
                @if (device.IsOnline)
                {
                    <a class="sd-btn sd-btn--secondary" href="devices/@device.Id/terminal">
                        <SdIcon Name="IconName.Terminal" />
                        Terminal
                    </a>
                }
                else
                {
                    <SdButton Variant="ButtonVariant.Secondary" Icon="IconName.Terminal" Disabled="true" aria-describedby="terminal-offline">Terminal</SdButton>
                    <span id="terminal-offline" class="sd-muted">Available when the device is online</span>
                }
            </div>
        }
    </header>

    @if (groupsError is not null)
    {
        <SdAlert>@groupsError</SdAlert>
    }

    <SdDialog Open="choosingGroups" Title="Groups" OnClose="() => choosingGroups = false">
        <ChildContent>
            <p class="sd-muted">@device.Name gets the access granted on each group it is in.</p>
            <div class="sd-member-picker">
                @foreach (var (id, name) in groupNames.OrderBy(x => x.Value, StringComparer.OrdinalIgnoreCase).Select(x => (x.Key, x.Value)))
                {
                    <SdCheckbox Label="@name" Checked="chosen.Contains(id)" CheckedChanged="on => Choose(id, on)" />
                }
            </div>
        </ChildContent>
        <Footer>
            <SdButton Variant="ButtonVariant.Ghost" OnClick="() => choosingGroups = false">Cancel</SdButton>
            <SdButton Disabled="savingGroups" OnClick="SaveGroupsAsync">@(savingGroups ? "Saving..." : "Save")</SdButton>
        </Footer>
    </SdDialog>

    <div class="sd-grid">
        <div class="sd-stat">
            <span class="sd-stat-label">CPU · @device.CpuCores cores</span>
            <span class="sd-stat-value">@DeviceFormat.Percent(device.CpuLoad)</span>
            <SdMeter Label="CPU" Value="device.CpuLoad" Large="true" />
        </div>
        <div class="sd-stat">
            <span class="sd-stat-label">Memory · @DeviceFormat.Usage(device.MemoryUsedGb, device.MemoryTotalGb)</span>
            <span class="sd-stat-value">@DeviceFormat.Percent(DeviceFormat.Share(device.MemoryUsedGb, device.MemoryTotalGb))</span>
            <SdMeter Label="Memory" Value="DeviceFormat.Share(device.MemoryUsedGb, device.MemoryTotalGb)" Large="true" />
        </div>
        <div class="sd-stat">
            <span class="sd-stat-label">Storage · @DeviceFormat.Usage(device.StorageUsedGb, device.StorageTotalGb)</span>
            <span class="sd-stat-value">@DeviceFormat.Percent(DeviceFormat.Share(device.StorageUsedGb, device.StorageTotalGb))</span>
            <SdMeter Label="Storage" Value="DeviceFormat.Share(device.StorageUsedGb, device.StorageTotalGb)" Large="true" />
        </div>
    </div>

    <div class="sd-grid" style="--sd-grid-min: 320px">
        <SdCard Title="System">
            <dl class="sd-details">
                <dt>Agent version</dt>
                <dd>@DeviceFormat.OrMissing(device.AgentVersion)</dd>
                <dt>Architecture</dt>
                <dd>@DeviceFormat.Architecture(device.OsArchitecture)</dd>
                <dt>Logged-on users</dt>
                <dd>@DeviceFormat.OrMissing(string.Join(", ", device.LoggedOnUsers))</dd>
                <dt>Last seen</dt>
                <dd>@DeviceFormat.LastSeen(device.LastSeen)</dd>
            </dl>
        </SdCard>
        <SdCard Title="Network">
            <dl class="sd-details">
                <dt>DNS name</dt>
                <dd>@DeviceFormat.OrMissing(device.DnsName)</dd>
                <dt>Local IP</dt>
                <dd class="sd-mono">@DeviceFormat.OrMissing(Join(device.LocalIpV4, device.LocalIpV6))</dd>
                <dt>Public IP</dt>
                <dd class="sd-mono">@DeviceFormat.OrMissing(Join(device.PublicIpV4, device.PublicIpV6))</dd>
                <dt>MAC addresses</dt>
                <dd class="sd-mono">@DeviceFormat.OrMissing(string.Join(", ", device.MacAddresses))</dd>
            </dl>
        </SdCard>
    </div>

    <SdCard Title="Disks">
        @if (device.Disks.Count == 0)
        {
            <p class="sd-muted">No disks reported.</p>
        }
        else
        {
            <div style="overflow-x: auto">
                <table class="sd-table sd-table--plain disks" style="min-width: 560px">
                    <thead>
                        <tr>
                            <th>Disk</th>
                            <th>Label</th>
                            <th>Format</th>
                            <th>Used</th>
                            <th>Free</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var disk in device.Disks)
                        {
                            <tr>
                                <td class="sd-mono">@disk.Name</td>
                                <td>@disk.Label</td>
                                <td>@disk.Format</td>
                                <td style="min-width: 200px">
                                    <SdMeter Label="@($"{disk.Name} used")" Value="DeviceFormat.Share(disk.SizeGb - disk.FreeGb, disk.SizeGb)"
                                             Text="@DeviceFormat.Usage(disk.SizeGb - disk.FreeGb, disk.SizeGb)" />
                                </td>
                                <td>@DeviceFormat.Gigabytes(disk.FreeGb) GB</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </SdCard>
}

@code {
    private DeviceLookup? lookup;
    private DeviceSummary? device;
    private IReadOnlyDictionary<Guid, string> groupNames = new Dictionary<Guid, string>();
    private readonly HashSet<Guid> chosen = [];
    private bool canReadGroups;
    private bool canUseTerminal;
    private bool actionsChecked;
    private bool canAssignGroups;
    private bool choosingGroups;
    private bool savingGroups;
    private string? groupsError;
    private Guid tenantId;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    [Inject]
    private StealthDesk.Web.Client.DeviceGroups.DeviceGroupApi DeviceGroups { get; set; } = default!;

    [Inject]
    private IAuthorizationService Authorization { get; set; } = default!;

    // Names of the groups the device is in; only for whoever may read the groups.
    private IReadOnlyList<(Guid Id, string Name)> GroupNames(DeviceSummary device) =>
        [.. device.GroupIds.Where(groupNames.ContainsKey).Select(x => (x, groupNames[x])).OrderBy(x => x.Item2, StringComparer.OrdinalIgnoreCase)];

    [Parameter]
    public Guid Id { get; set; }

    protected override void OnInitialized()
    {
        Store.Changed += OnStoreChanged;
        Live.StateChanged += OnLiveChanged;
        _ = Live.StartAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        lookup = null;
        lookup = await Store.FindAsync(Id);
        device = lookup.Device;
        actionsChecked = false;
        canUseTerminal = false;
        await CheckActionsAsync();

        var user = AuthenticationState is null ? null : (await AuthenticationState).User;
        canReadGroups = device is not null && user is not null
            && (await Authorization.AuthorizeAsync(user, PermissionPolicies.For(PermissionNames.TenantDeviceGroupsRead))).Succeeded
            && Guid.TryParse(user.FindFirst(ServerAuthenticationState.TenantIdClaim)?.Value, out tenantId);
        if (canReadGroups)
        {
            canAssignGroups = (await Authorization.AuthorizeAsync(user!, PermissionPolicies.For(PermissionNames.DeviceGroupAssignDevices))).Succeeded;
            groupNames = (await DeviceGroups.ListAsync(tenantId)).Value?.Items.ToDictionary(x => x.Id, x => x.Name) ?? new Dictionary<Guid, string>();
        }
    }

    private void OpenGroups()
    {
        chosen.Clear();
        chosen.UnionWith(device!.GroupIds);
        groupsError = null;
        choosingGroups = true;
    }

    private void Choose(Guid group, bool on)
    {
        if (on)
        {
            chosen.Add(group);
        }
        else
        {
            chosen.Remove(group);
        }
    }

    // Each group added or left is a change of that group, checked against what the user may do there. Leaving one
    // group for another is a move: one change, as when moving from the group's page.
    private async Task SaveGroupsAsync()
    {
        var current = device!.GroupIds.ToHashSet();
        var joining = chosen.Where(x => !current.Contains(x)).ToList();
        var leaving = current.Where(x => !chosen.Contains(x)).ToList();
        savingGroups = true;
        var errors = new List<string>();
        if (joining.Count == 1 && leaving.Count == 1)
        {
            Collect(await DeviceGroups.AddDevicesAsync(joining[0], tenantId, [device.Id], fromGroupId: leaving[0]), errors);
        }
        else
        {
            foreach (var group in joining)
            {
                Collect(await DeviceGroups.AddDevicesAsync(group, tenantId, [device.Id]), errors);
            }

            foreach (var group in leaving)
            {
                Collect(await DeviceGroups.RemoveDevicesAsync(group, tenantId, [device.Id]), errors);
            }
        }

        savingGroups = false;
        choosingGroups = false;
        groupsError = errors.Count == 0 ? null : string.Join(" ", errors.Distinct());
        if (await Store.RefreshAsync(Id) is { } updated)
        {
            device = updated;
        }
    }

    private void Collect(StealthDesk.Web.Client.UserGroups.GroupResult<bool> result, List<string> errors)
    {
        if (result.SessionExpired)
        {
            Store.ReportSessionExpired();
        }
        else if (result.Error is { } error)
        {
            errors.Add(error);
        }
    }

    // Asked over the live connection once it is up; the server checks again when an action is used.
    private async Task CheckActionsAsync()
    {
        if (actionsChecked || device is null || Live.State != LiveState.Live)
        {
            return;
        }

        actionsChecked = true;
        var actions = await Hub.GetDeviceActionsAsync(Id);
        canUseTerminal = actions is { Accepted: true, Value.UseTerminal: true };
    }

    private void OnLiveChanged() => InvokeAsync(async () =>
    {
        await CheckActionsAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Store.Changed -= OnStoreChanged;
        Live.StateChanged -= OnLiveChanged;
    }

    // The same live updates as the list: a pushed change for this device replaces what is shown.
    private void OnStoreChanged() => InvokeAsync(() =>
    {
        if (Store.Get(Id) is { } current)
        {
            device = current;
            lookup = DeviceLookup.Found(current);
        }

        StateHasChanged();
    });

    private static string Join(params string[] values) => string.Join(", ", values.Where(x => x.Length > 0));

    private static string Subtitle(DeviceSummary device) =>
        string.Join(" · ", new[] { device.DnsName, device.OsDescription }.Where(x => x.Length > 0));
}
