@page "/devices/{Id:guid}/files"
@attribute [Authorize]
@implements IDisposable
@using System.Net
@using System.Text.Json
@inject DeviceStore Store
@inject HttpClient Http
@inject ILiveUpdates Live
@inject IDeviceHub Hub

<PageTitle>Files · @(device?.Name ?? "Device") · StealthDesk</PageTitle>

<a class="sd-back" href="devices/@Id">
    <SdIcon Name="IconName.Back" Size="16" />
    @(device?.Name ?? "Device")
</a>

@if (lookup is null)
{
    <SdLoading Text="Loading device..." />
}
else if (device is null)
{
    <SdAlert>Could not load the device. Check that the server is running.</SdAlert>
}
else
{
    <header class="sd-page-header">
        <div>
            <h1 class="sd-page-title">Files</h1>
            <p class="sd-muted">@device.Name</p>
        </div>
    </header>

    @if (listing is not null)
    {
        <nav aria-label="Path">
            @foreach (var (label, path) in Breadcrumbs(listing.Path))
            {
                <button type="button" class="sd-link-button" @onclick="() => LoadAsync(path)">@label</button>
                <span aria-hidden="true"> / </span>
            }
        </nav>
    }

    @if (canUpload && listing is { Exists: true })
    {
        <div class="sd-file-upload">
            <InputFile OnChange="OnFileSelectedAsync" disabled="@uploading" />
            @if (uploading)
            {
                <SdLoading Text="Uploading..." />
            }
        </div>
        @if (uploadError is not null)
        {
            <SdAlert>@uploadError</SdAlert>
        }
    }

    @if (loading)
    {
        <SdLoading Text="Loading files..." />
    }
    else if (error is not null)
    {
        <SdAlert>@error</SdAlert>
    }
    else if (listing is { Exists: false })
    {
        <SdEmptyState Title="Not found">This folder doesn't exist, or isn't reachable right now.</SdEmptyState>
    }
    else if (listing is { Entries.Count: 0 })
    {
        <SdEmptyState Title="Empty">This folder has nothing in it.</SdEmptyState>
    }
    else if (listing is not null)
    {
        <div class="sd-table-wrap">
            <table class="sd-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Size</th>
                        <th>Modified</th>
                        <th><span class="sd-visually-hidden">Download</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in listing.Entries)
                    {
                        <tr @key="entry.Name">
                            <td>
                                @if (entry.IsDirectory)
                                {
                                    <button type="button" class="sd-link-button" @onclick="() => LoadAsync(Combine(listing.Path, entry.Name))">
                                        <SdIcon Name="IconName.Folder" Size="16" />
                                        @entry.Name
                                    </button>
                                }
                                else
                                {
                                    @entry.Name
                                }
                            </td>
                            <td>@(entry.IsDirectory ? "" : FormatSize(entry.SizeBytes))</td>
                            <td>@entry.ModifiedAt.ToLocalTime().ToString("g")</td>
                            <td class="sd-row-actions">
                                <a class="sd-link-button" href="@Routes.DeviceFileDownload(Id, Combine(listing.Path, entry.Name))" download>
                                    <SdIcon Name="IconName.Download" Size="16" />
                                    @(entry.IsDirectory ? "Download as zip" : "Download")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private DeviceLookup? lookup;
    private DeviceSummary? device;
    private DirectoryListing? listing;
    private bool loading;
    private string? error;
    private bool actionsChecked;
    private bool canUpload;
    private bool uploading;
    private string? uploadError;

    protected override void OnInitialized()
    {
        Live.StateChanged += OnLiveChanged;
        _ = Live.StartAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        lookup = await Store.FindAsync(Id);
        device = lookup.Device;
        actionsChecked = false;
        canUpload = false;
        await CheckActionsAsync();
        if (device is not null && listing is null)
        {
            await LoadAsync(string.Empty);
        }
    }

    // Asked once the live connection is up, same as every other page gating an action on device.file-manager.write.
    private async Task CheckActionsAsync()
    {
        if (actionsChecked || device is null || Live.State != LiveState.Live)
        {
            return;
        }

        actionsChecked = true;
        var actions = await Hub.GetDeviceActionsAsync(Id);
        canUpload = actions is { Accepted: true, Value.UploadFiles: true };
    }

    private void OnLiveChanged() => InvokeAsync(async () =>
    {
        await CheckActionsAsync();
        StateHasChanged();
    });

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs args)
    {
        if (listing is not { Exists: true })
        {
            return;
        }

        uploading = true;
        uploadError = null;
        StateHasChanged();
        try
        {
            var file = args.File;
            await using var stream = file.OpenReadStream(long.MaxValue);
            using var content = new StreamContent(stream);
            using var response = await Http.PostAsync(Routes.DeviceFileUpload(Id, listing.Path, file.Name, overwrite: false), content);
            if (response.IsSuccessStatusCode)
            {
                await LoadAsync(listing.Path);
            }
            else
            {
                uploadError = response.StatusCode switch
                {
                    HttpStatusCode.Conflict => "A file with that name already exists.",
                    HttpStatusCode.RequestEntityTooLarge => "The file is larger than the server allows.",
                    HttpStatusCode.NotFound => "The device went offline, or you may not upload here.",
                    _ => "Could not upload the file.",
                };
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or IOException)
        {
            uploadError = "Could not upload the file. Check that the device is online.";
        }
        finally
        {
            uploading = false;
            StateHasChanged();
        }
    }

    public void Dispose() => Live.StateChanged -= OnLiveChanged;

    private async Task LoadAsync(string path)
    {
        loading = true;
        error = null;
        StateHasChanged();
        try
        {
            listing = await Http.GetFromJsonAsync<DirectoryListing>(Routes.DeviceFiles(Id, path));
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            error = "Could not load the files. Check that the device is online.";
        }
        finally
        {
            loading = false;
        }
    }

    // One entry per folder from the drive down to the current one; clicking one reloads at that depth.
    private static IEnumerable<(string Label, string Path)> Breadcrumbs(string path)
    {
        var separator = path.Contains('\\') ? '\\' : '/';
        var segments = path.Split(separator, StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length == 0)
        {
            yield break;
        }

        // A drive letter on its own ("C:") isn't a path the agent can list; it needs the separator for its root.
        var built = segments[0].EndsWith(':') ? segments[0] + separator : segments[0];
        yield return (segments[0], built);
        for (var i = 1; i < segments.Length; i++)
        {
            built = built.EndsWith(separator) ? built + segments[i] : $"{built}{separator}{segments[i]}";
            yield return (segments[i], built);
        }
    }

    private static string Combine(string parent, string name) =>
        parent.EndsWith('\\') || parent.EndsWith('/') ? parent + name : parent + "\\" + name;

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        < 1024 * 1024 * 1024 => $"{bytes / 1024.0 / 1024:0.#} MB",
        _ => $"{bytes / 1024.0 / 1024 / 1024:0.#} GB",
    };
}
