@using StealthDesk.Contracts.ServiceAccounts
@inject ServiceAccountApi Api
@inject SessionGuard Session
@inject IJSRuntime Js
@inject IAuthorizationService Authorization
@inject NavigationManager Navigation
@inject TimeProvider Clock

@* A tenant's service accounts, or the server's when there is no tenant, and their credentials. *@

<header class="sd-page-header">
    <h1 class="sd-page-title">@Title</h1>
    <div class="sd-push">
        <SdButton Variant="ButtonVariant.Secondary" Icon="IconName.Refresh" AriaLabel="Refresh" OnClick="LoadAsync" />
    </div>
    @if (canWrite)
    {
        <SdButton OnClick="StartCreate">New account</SdButton>
    }
</header>
<p class="sd-muted sd-page-lead">@Lead Scripts send one of an account's keys in the <code>@ServiceAccountHeader.Name</code> header.</p>

@if (error is not null)
{
    <SdAlert>@error</SdAlert>
}

@if (accounts is null)
{
    @if (error is null)
    {
        <SdLoading Text="Loading service accounts..." />
    }
}
else if (accounts.Count == 0)
{
    <SdEmptyState Title="No service accounts">Create one for an integration that shouldn't depend on a person's account.</SdEmptyState>
}
else
{
    <div class="sd-table-wrap">
        <table class="sd-table" style="min-width: 820px">
            <thead>
                <tr>
                    <th>Name</th>
                    @if (IsServer)
                    {
                        <th>Access</th>
                    }
                    <th>Enabled</th>
                    <th>Keys</th>
                    <th>Created</th>
                    <th><span class="sd-visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in accounts)
                {
                    var open = expanded.Contains(account.Id);
                    <tr @key="account.Id" data-account="@account.Name">
                        <td>
                            <div>@account.Name</div>
                            @if (account.Description is { } description)
                            {
                                <div class="sd-muted sd-text-sm">@description</div>
                            }
                        </td>
                        @if (IsServer)
                        {
                            <td>
                                <SdStatus Tone="@(account.AccessMode == ServiceAccountAccessMode.Unrestricted ? Tone.Warning : Tone.Info)"
                                          Text="@(account.AccessMode == ServiceAccountAccessMode.Unrestricted ? "Unrestricted" : "Restricted")" />
                            </td>
                        }
                        <td>
                            <SdCheckbox Label="@(account.IsEnabled ? "On" : "Off")" Checked="account.IsEnabled" Disabled="!canWrite || busy"
                                        CheckedChanged="on => SetEnabledAsync(account, on)" />
                        </td>
                        <td>
                            <SdButton Variant="ButtonVariant.Ghost" Icon="@(open ? IconName.ChevronUp : IconName.ChevronDown)" OnClick="() => Toggle(account.Id)"
                                      aria-expanded="@(open ? "true" : "false")">
                                @Active(account) active of @account.Credentials.Count
                            </SdButton>
                        </td>
                        <td class="sd-muted" style="white-space: nowrap">@Date(account.CreatedAt)</td>
                        <td class="sd-row-actions">
                            @if (canRotate)
                            {
                                <SdButton Variant="ButtonVariant.Ghost" Disabled="!account.IsEnabled" OnClick="() => StartAddCredential(account)">Add key</SdButton>
                            }
                            @if (canSeePermissions)
                            {
                                <a class="sd-btn sd-btn--ghost" href="@PermissionsLink(account.Id)">Permissions</a>
                            }
                            @if (canWrite)
                            {
                                <SdButton Variant="ButtonVariant.Ghost" OnClick="() => StartEdit(account)">Edit</SdButton>
                                <SdButton Variant="ButtonVariant.Ghost" OnClick="() => Confirm(Pending.Delete(account))">Delete</SdButton>
                            }
                        </td>
                    </tr>
                    @if (open)
                    {
                        <tr @key="(account.Id, 1)" class="sd-subrow" data-credentials="@account.Name">
                            <td colspan="@(IsServer ? 6 : 5)">
                                @if (account.Credentials.Count == 0)
                                {
                                    <p class="sd-muted">No keys yet.@(canRotate ? " Add one to let a script sign in as this account." : string.Empty)</p>
                                }
                                else
                                {
                                    <table class="sd-table sd-table--nested">
                                        <thead>
                                            <tr>
                                                <th>Key</th>
                                                <th>Status</th>
                                                <th>Created</th>
                                                <th>Last used</th>
                                                <th>Expires</th>
                                                <th><span class="sd-visually-hidden">Actions</span></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var credential in account.Credentials)
                                            {
                                                var (tone, status) = StatusOf(credential);
                                                <tr @key="credential.Id" data-credential="@credential.Name">
                                                    <td>@credential.Name</td>
                                                    <td><SdStatus Tone="tone" Text="@status" /></td>
                                                    <td class="sd-muted">@Date(credential.CreatedAt)</td>
                                                    <td class="sd-muted">@(credential.LastUsed is { } used ? Date(used) : "Never")</td>
                                                    <td class="sd-muted">@(credential.ExpiresAt is { } expires ? Date(expires) : "Never")</td>
                                                    <td class="sd-row-actions">
                                                        @if (canRotate)
                                                        {
                                                            @if (status == "Active")
                                                            {
                                                                <SdButton Variant="ButtonVariant.Ghost" OnClick="() => Confirm(Pending.Revoke(account, credential))">Revoke</SdButton>
                                                            }
                                                            else
                                                            {
                                                                <SdButton Variant="ButtonVariant.Ghost" OnClick="() => Confirm(Pending.Purge(account, credential))">Delete</SdButton>
                                                            }
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

<SdDialog Open="creating" Title="New service account" OnClose="() => creating = false">
    <ChildContent>
        <SdTextField Label="Name" Autocomplete="off" @bind-Value="name" Error="@formError" />
        <SdTextField Label="Description" Autocomplete="off" @bind-Value="description" />
        @if (IsServer)
        {
            <SdSegmented TValue="ServiceAccountAccessMode" Label="Access" Options="@AccessModes" @bind-Value="accessMode" />
            <p class="sd-muted sd-text-sm">
                <strong>Restricted</strong> can only do what its permissions allow; none means no access.
                <strong>Unrestricted</strong> can do anything on the server.
                @if (!canGrantUnrestricted)
                {
                    <span>Creating an unrestricted account takes the right to manage the server's permissions.</span>
                }
            </p>
        }
        @if (canRotate)
        {
            <SdCheckbox Label="Create a first key" @bind-Checked="withCredential" />
            @if (withCredential)
            {
                <SdTextField Label="Key name" Autocomplete="off" @bind-Value="credentialName" />
                <SdSelect Label="Expires" Options="Lifetimes" @bind-Value="lifetime" />
            }
        }
        else
        {
            <p class="sd-muted sd-text-sm">Your account can't issue keys; someone who can rotate credentials adds one later.</p>
        }
    </ChildContent>
    <Footer>
        <SdButton Variant="ButtonVariant.Ghost" OnClick="() => creating = false">Cancel</SdButton>
        <SdButton Disabled="busy" OnClick="CreateAsync">Create</SdButton>
    </Footer>
</SdDialog>

<SdDialog Open="editing is not null" Title="Edit service account" OnClose="() => editing = null">
    <ChildContent>
        <SdTextField Label="Name" Autocomplete="off" @bind-Value="name" Error="@formError" />
        <SdTextField Label="Description" Autocomplete="off" @bind-Value="description" />
    </ChildContent>
    <Footer>
        <SdButton Variant="ButtonVariant.Ghost" OnClick="() => editing = null">Cancel</SdButton>
        <SdButton Disabled="busy" OnClick="SaveEditAsync">Save</SdButton>
    </Footer>
</SdDialog>

<SdDialog Open="addingTo is not null" Title="Add a key" OnClose="() => addingTo = null">
    <ChildContent>
        <p class="sd-muted">To rotate, add the new key, switch your script to it, then revoke the old one.</p>
        <SdTextField Label="Key name" Autocomplete="off" @bind-Value="credentialName" Error="@formError" />
        <SdSelect Label="Expires" Options="Lifetimes" @bind-Value="lifetime" />
    </ChildContent>
    <Footer>
        <SdButton Variant="ButtonVariant.Ghost" OnClick="() => addingTo = null">Cancel</SdButton>
        <SdButton Disabled="busy" OnClick="AddCredentialAsync">Add key</SdButton>
    </Footer>
</SdDialog>

<SdDialog Open="shown is not null" Title="Copy the new key" OnClose="CloseKeyAsync">
    <ChildContent>
        <p class="sd-muted">
            This is the only time the key for <strong>@shown?.Account</strong> is shown. Store it somewhere safe, like a
            secrets manager; if it's lost, revoke it and add another.
        </p>
        <code class="sd-secret" data-secret>@shown?.Key</code>
    </ChildContent>
    <Footer>
        <SdButton Variant="ButtonVariant.Secondary" Icon="IconName.Copy" OnClick="CopyAsync">@(copied ? "Copied" : "Copy key")</SdButton>
        <SdButton OnClick="CloseKeyAsync">Done</SdButton>
    </Footer>
</SdDialog>

<SdDialog Open="pending is not null" Title="@(pending?.Title ?? string.Empty)" OnClose="() => pending = null">
    <ChildContent>
        <p class="sd-muted">@pending?.Explanation</p>
    </ChildContent>
    <Footer>
        <SdButton Variant="ButtonVariant.Ghost" OnClick="() => pending = null">Cancel</SdButton>
        <SdButton Variant="ButtonVariant.Danger" Disabled="busy" OnClick="ConfirmedAsync">@pending?.Action</SdButton>
    </Footer>
</SdDialog>

@code {
    private static readonly IReadOnlyList<(ServiceAccountAccessMode, string)> AccessModes =
        [(ServiceAccountAccessMode.Restricted, "Restricted"), (ServiceAccountAccessMode.Unrestricted, "Unrestricted")];

    // The same choices as personal access tokens; the API also takes any future date.
    private static readonly IReadOnlyList<SelectOption> Lifetimes =
        [.. Contracts.PersonalAccessTokens.CreatePersonalAccessTokenRequest.Lifetimes.Select(x => new SelectOption(x.ToString(), $"In {x} days")), new SelectOption(string.Empty, "Never")];

    private static readonly string DefaultLifetime = Contracts.PersonalAccessTokens.CreatePersonalAccessTokenRequest.DefaultLifetimeDays.ToString();

    private IReadOnlyList<ServiceAccount>? accounts;
    private readonly HashSet<Guid> expanded = [];
    private bool canWrite;
    private bool canRotate;
    private bool canSeePermissions;
    private bool canGrantUnrestricted;
    private bool creating;
    private ServiceAccount? editing;
    private ServiceAccount? addingTo;
    private (string Account, string Key, Guid AccountId, bool AfterCreate)? shown;
    private Pending? pending;
    private string? name;
    private string? description;
    private ServiceAccountAccessMode accessMode;
    private bool withCredential = true;
    private string? credentialName;
    private string? lifetime = DefaultLifetime;
    private string? error;
    private string? formError;
    private bool copied;
    private bool busy;

    /// <summary>The tenant whose accounts these are; none for the server's.</summary>
    [Parameter]
    public Guid? TenantId { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Lead { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string WritePermission { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string RotatePermission { get; set; } = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private bool IsServer => TenantId is null;

    protected override async Task OnInitializedAsync()
    {
        var user = AuthenticationState is null ? new System.Security.Claims.ClaimsPrincipal() : (await AuthenticationState).User;
        async Task<bool> Holds(string permission) => (await Authorization.AuthorizeAsync(user, PermissionPolicies.For(permission))).Succeeded;
        canWrite = await Holds(WritePermission);
        canRotate = await Holds(RotatePermission);
        // A server account's permissions are managed by who manages the server's.
        canSeePermissions = await Holds(PermissionNames.TenantPermissionsRead) && (!IsServer || await Holds(PermissionNames.ServerPermissionsRead));
        canGrantUnrestricted = IsServer && await Holds(PermissionNames.ServerPermissionsWrite);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        error = null;
        var result = await Api.ListAsync(TenantId);
        if (Expired(result.SessionExpired))
        {
            return;
        }

        accounts = result.Value?.Items;
        error = result.Error;
    }

    private void Toggle(Guid id)
    {
        if (!expanded.Remove(id))
        {
            expanded.Add(id);
        }
    }

    private void StartCreate()
    {
        creating = true;
        name = description = formError = null;
        accessMode = ServiceAccountAccessMode.Restricted;
        withCredential = canRotate;
        credentialName = "Primary";
        lifetime = DefaultLifetime;
    }

    private async Task CreateAsync()
    {
        formError = null;
        if (string.IsNullOrWhiteSpace(name))
        {
            formError = "Enter a name for the account.";
            return;
        }

        if (IsServer && accessMode == ServiceAccountAccessMode.Unrestricted && !canGrantUnrestricted)
        {
            formError = "Your account can't create unrestricted accounts.";
            return;
        }

        if (withCredential && string.IsNullOrWhiteSpace(credentialName))
        {
            formError = "Enter a name for the first key, or don't create one.";
            return;
        }

        busy = true;
        var created = await Api.CreateAsync(TenantId, new CreateServiceAccountRequest(name.Trim(), description, accessMode));
        if (Expired(created.SessionExpired) || !created.Succeeded)
        {
            busy = false;
            formError = created.Error;
            return;
        }

        creating = false;
        var account = created.Value!;
        if (withCredential)
        {
            var key = await Api.AddCredentialAsync(TenantId, account.Id, new CreateServiceAccountCredentialRequest(credentialName!.Trim(), ExpiresAt()));
            if (Expired(key.SessionExpired))
            {
                busy = false;
                return;
            }

            if (key.Succeeded)
            {
                Show(account, key.Value!, afterCreate: true);
            }
            else
            {
                error = $"{account.Name} was created, but its key wasn't: {key.Error}";
            }
        }

        busy = false;
        expanded.Add(account.Id);
        await LoadAsync();
        if (!withCredential)
        {
            await OpenPermissionsAsync(account.Id);
        }
    }

    private void StartEdit(ServiceAccount account)
    {
        editing = account;
        name = account.Name;
        description = account.Description;
        formError = null;
    }

    private async Task SaveEditAsync()
    {
        if (editing is not { } account)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(name))
        {
            formError = "Enter a name for the account.";
            return;
        }

        busy = true;
        var result = await Api.UpdateAsync(TenantId, account.Id, new UpdateServiceAccountRequest(name.Trim(), description, account.IsEnabled));
        busy = false;
        if (Expired(result.SessionExpired))
        {
            return;
        }

        if (!result.Succeeded)
        {
            formError = result.Error;
            return;
        }

        editing = null;
        await LoadAsync();
    }

    private async Task SetEnabledAsync(ServiceAccount account, bool enabled)
    {
        busy = true;
        var result = await Api.UpdateAsync(TenantId, account.Id, new UpdateServiceAccountRequest(account.Name, account.Description, enabled));
        busy = false;
        if (Expired(result.SessionExpired))
        {
            return;
        }

        error = result.Error;
        await LoadAsync();
    }

    private void StartAddCredential(ServiceAccount account)
    {
        addingTo = account;
        credentialName = null;
        lifetime = DefaultLifetime;
        formError = null;
    }

    private async Task AddCredentialAsync()
    {
        if (addingTo is not { } account)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(credentialName))
        {
            formError = "Enter a name for the key.";
            return;
        }

        busy = true;
        var result = await Api.AddCredentialAsync(TenantId, account.Id, new CreateServiceAccountCredentialRequest(credentialName.Trim(), ExpiresAt()));
        busy = false;
        if (Expired(result.SessionExpired))
        {
            return;
        }

        if (!result.Succeeded)
        {
            formError = result.Error;
            return;
        }

        addingTo = null;
        expanded.Add(account.Id);
        Show(account, result.Value!, afterCreate: false);
        await LoadAsync();
    }

    private void Show(ServiceAccount account, CreatedServiceAccountCredential key, bool afterCreate)
    {
        shown = (account.Name, key.ApiKey, account.Id, afterCreate);
        copied = false;
    }

    // A new account starts with no permissions; whoever may manage them is taken there next.
    private async Task CloseKeyAsync()
    {
        var closed = shown;
        shown = null;
        if (closed is { AfterCreate: true } key)
        {
            await OpenPermissionsAsync(key.AccountId);
        }
    }

    private Task OpenPermissionsAsync(Guid id)
    {
        if (canSeePermissions)
        {
            Navigation.NavigateTo(PermissionsLink(id));
        }

        return Task.CompletedTask;
    }

    private async Task CopyAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", shown?.Key);
            copied = true;
        }
        catch (JSException)
        {
            error = "The browser didn't allow copying. Select the key and copy it yourself.";
        }
    }

    private void Confirm(Pending what) => pending = what;

    private async Task ConfirmedAsync()
    {
        if (pending is not { } what)
        {
            return;
        }

        busy = true;
        var result = what.Kind switch
        {
            PendingKind.Delete => await Api.DeleteAsync(TenantId, what.Account.Id),
            PendingKind.Revoke => await Api.RevokeCredentialAsync(TenantId, what.Account.Id, what.Credential!.Id),
            _ => await Api.PurgeCredentialAsync(TenantId, what.Account.Id, what.Credential!.Id),
        };
        busy = false;
        pending = null;
        if (Expired(result.SessionExpired))
        {
            return;
        }

        error = result.Error;
        await LoadAsync();
    }

    private DateTimeOffset? ExpiresAt() => int.TryParse(lifetime, out var days) ? Clock.GetUtcNow().AddDays(days) : null;

    private int Active(ServiceAccount account) => account.Credentials.Count(x => StatusOf(x).Text == "Active");

    private (Tone Tone, string Text) StatusOf(ServiceAccountCredential credential) =>
        credential.RevokedAt is not null ? (Tone.Danger, "Revoked")
        : credential.ExpiresAt <= Clock.GetUtcNow() ? (Tone.Warning, "Expired")
        : (Tone.Online, "Active");

    private static string PermissionsLink(Guid id) => $"permissions?kind={PermissionPrincipalKind.ServiceAccount}&id={id}";

    private static string Date(DateTimeOffset value) => value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private bool Expired(bool sessionExpired)
    {
        if (sessionExpired)
        {
            Session.Expired();
        }

        return sessionExpired;
    }

    private enum PendingKind
    {
        Delete,
        Revoke,
        Purge,
    }

    /// <summary>A destructive action waiting for a yes.</summary>
    private sealed record Pending(PendingKind Kind, ServiceAccount Account, ServiceAccountCredential? Credential, string Title, string Explanation, string Action)
    {
        public static Pending Delete(ServiceAccount account) => new(
            PendingKind.Delete, account, null, "Delete this service account?",
            $"Every key of {account.Name} stops working right away, and its permissions are removed.", "Delete");

        public static Pending Revoke(ServiceAccount account, ServiceAccountCredential credential) => new(
            PendingKind.Revoke, account, credential, "Revoke this key?",
            $"Anything still using {credential.Name} of {account.Name} stops working right away. The account's other keys keep working.", "Revoke");

        public static Pending Purge(ServiceAccount account, ServiceAccountCredential credential) => new(
            PendingKind.Purge, account, credential, "Delete this key?",
            $"{credential.Name} no longer works; deleting removes it from the list for good.", "Delete");
    }
}
