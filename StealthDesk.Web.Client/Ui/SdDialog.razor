@if (Open)
{
    <div class="sd-dialog-backdrop" @onclick="Close">
        <div class="sd-dialog" role="dialog" aria-modal="true" aria-labelledby="@_titleId" tabindex="-1"
             @onclick:stopPropagation="true" @onkeydown="KeyDown">
            <h2 id="@_titleId" class="sd-dialog-title">@Title</h2>
            @ChildContent
            @if (Footer is not null)
            {
                <div class="sd-dialog-footer">@Footer</div>
            }
        </div>
    </div>
}

@code {
    private readonly string _titleId = $"dialog-{Guid.NewGuid():N}";

    [Parameter]
    public bool Open { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Raised by the backdrop and the Escape key; the parent decides whether to close.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Footer { get; set; }

    private Task Close() => OnClose.InvokeAsync();

    private Task KeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;
}
