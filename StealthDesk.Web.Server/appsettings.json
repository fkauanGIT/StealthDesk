{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "ClockTolerance": "00:01:00"
  },
  "ReverseProxy": {
    "TrustedProxies": [],
    "TrustedNetworks": [],
    "DockerGatewayAddress": "",
    "TrustCloudflare": false,
    "TrustAllProxies": false
  },
  "KeyProtection": {
    "EncryptKeys": false,
    "Certificate": {
      "Path": "",
      "Base64": "",
      "Password": ""
    },
    "PreviousCertificates": []
  },
  "InstallerKeys": {
    "UsageHistoryDays": 90
  },
  "TenantDefaults": {
    "AppendInstanceName": false,
    "InstanceName": "",
    "NotifyUserOnRemoteControl": true
  },
  "Accounts": {
    "EnableBearerLogin": false,
    "BearerTokenLifetime": "01:00:00",
    "RefreshTokenLifetime": "30.00:00:00",
    "RequireUniqueEmail": true,
    "EnablePublicRegistration": false,
    "DisableFirstUserSelfRegistration": false,
    "RequireConfirmedEmail": false,
    "PersistPasskeySignIn": false,
    "MicrosoftClientId": "",
    "MicrosoftClientSecret": "",
    "GitHubClientId": "",
    "GitHubClientSecret": ""
  },
  "Email": {
    "DisableSending": false,
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUserName": "",
    "SmtpPassword": "",
    "SenderName": "StealthDesk",
    "SenderAddress": ""
  }
}
