<?xml version="1.0" encoding="utf-8"?>
<!--
  The agent the server hands out: one executable that carries the .NET runtime, so a clean Windows machine runs it.
  dotnet publish agent/StealthDesk.Agent -p:PublishProfile=Windows -o <folder>
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- About half the size; the agent starts once, so unpacking costs little. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
