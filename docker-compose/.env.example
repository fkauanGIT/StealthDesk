# Copy to .env next to docker-compose.yml. .env stays out of git: it holds passwords.
#
# Server settings are StealthDesk_ followed by the setting, with __ between sections:
# Accounts:EnablePublicRegistration is StealthDesk_Accounts__EnablePublicRegistration.
# Lines starting with # keep the default shown. The README's "Server settings" table explains each one.

# ---------------------------------------------------------------- Compose

# The server image version. Pin one (0.5.0) and update on purpose.
#SERVER_IMAGE_TAG=latest
# The host port the server listens on.
#SERVER_PORT=8080
# The Docker network, and its gateway, which a reverse proxy on the host comes through.
# Change both if 172.30.0.0/16 is already used on this machine.
#DOCKER_SUBNET=172.30.0.0/16
#DOCKER_GATEWAY=172.30.0.1

# ---------------------------------------------------------------- Database

StealthDesk_POSTGRES_USER=postgres
# Required. The database is created with it the first time; changing it later doesn't change the database's.
StealthDesk_POSTGRES_PASSWORD=
#StealthDesk_POSTGRES_DB=stealthdesk
# Off, the server only checks the schema is up to date and refuses to start otherwise.
#StealthDesk_ApplyMigrationsOnStart=true

# ---------------------------------------------------------------- First administrator

# Created on a start while the server has no users. Both or neither.
#StealthDesk_Bootstrap__AdminEmail=admin@example.com
#StealthDesk_Bootstrap__AdminPassword=
# A personal access token for that administrator, {id}:{secret}. The secret needs 32 characters or more.
#StealthDesk_Bootstrap__AdminTokenId=
#StealthDesk_Bootstrap__AdminTokenSecret=
# An unrestricted server service account and its key, {credential id}:{secret}. All three or none.
#StealthDesk_Bootstrap__ServerServiceAccountName=
#StealthDesk_Bootstrap__ServerServiceAccountCredentialId=
#StealthDesk_Bootstrap__ServerServiceAccountCredentialSecret=
#StealthDesk_Bootstrap__ServerServiceAccountId=
#StealthDesk_Bootstrap__ServerServiceAccountDescription=

# ---------------------------------------------------------------- Accounts

#StealthDesk_Accounts__EnablePublicRegistration=false
#StealthDesk_Accounts__DisableFirstUserSelfRegistration=false
#StealthDesk_Accounts__RequireConfirmedEmail=false
#StealthDesk_Accounts__RequireUniqueEmail=true
#StealthDesk_Accounts__PersistPasskeySignIn=false
# Auto, Light or Dark.
#StealthDesk_Accounts__DefaultTheme=Auto
#StealthDesk_Accounts__EnableBearerLogin=false
#StealthDesk_Accounts__BearerTokenLifetime=01:00:00
#StealthDesk_Accounts__RefreshTokenLifetime=30.00:00:00
# Sign in with Microsoft or GitHub: on only when both values are set.
#StealthDesk_Accounts__MicrosoftClientId=
#StealthDesk_Accounts__MicrosoftClientSecret=
#StealthDesk_Accounts__GitHubClientId=
#StealthDesk_Accounts__GitHubClientSecret=

# ---------------------------------------------------------------- Email

#StealthDesk_Email__DisableSending=false
#StealthDesk_Email__SmtpHost=
#StealthDesk_Email__SmtpPort=587
#StealthDesk_Email__SmtpUserName=
#StealthDesk_Email__SmtpPassword=
#StealthDesk_Email__SmtpLocalDomain=
#StealthDesk_Email__SmtpCheckCertificateRevocation=true
#StealthDesk_Email__SenderName=StealthDesk
#StealthDesk_Email__SenderAddress=

# ---------------------------------------------------------------- Agents and tenants

#StealthDesk_TenantDefaults__AppendInstanceName=false
#StealthDesk_TenantDefaults__InstanceName=
# Empty turns the agent clock check off.
#StealthDesk_Gateway__ClockTolerance=00:01:00
#StealthDesk_InstallerKeys__UsageHistoryDays=90
#StealthDesk_AuthorizationLogs__RetentionDays=365
#StealthDesk_ServiceAccounts__AuthFailureLimit=5
#StealthDesk_ServiceAccounts__AuthFailureWindowMinutes=5
#StealthDesk_ServiceAccounts__CredentialCleanupAfterDays=30

# ---------------------------------------------------------------- Agent downloads

# Where the agent builds the server hands out are. The image ships the Windows agent in its own downloads folder.
#StealthDesk_AgentDownloads__Folder=downloads

# ---------------------------------------------------------------- Reverse proxy

# The Docker gateway (DOCKER_GATEWAY) is already trusted. Add other proxies here, one per index.
#StealthDesk_ReverseProxy__TrustedProxies__0=
#StealthDesk_ReverseProxy__TrustedNetworks__0=
#StealthDesk_ReverseProxy__TrustCloudflare=false
# Only when nothing but the proxy can reach the server.
#StealthDesk_ReverseProxy__TrustAllProxies=false

# ---------------------------------------------------------------- Data protection keys

# Put the .pfx in the certificates folder next to this file; the server sees it, read-only, in /certificates.
#StealthDesk_KeyProtection__EncryptKeys=true
#StealthDesk_KeyProtection__Certificate__Path=/certificates/keys.pfx
# Or the .pfx contents in base64 instead of a file; it wins over the path.
#StealthDesk_KeyProtection__Certificate__Base64=
#StealthDesk_KeyProtection__Certificate__Password=
# After a rotation, the certificate the older keys were encrypted with, from a file or base64.
#StealthDesk_KeyProtection__PreviousCertificates__0__Path=/certificates/previous-keys.pfx
#StealthDesk_KeyProtection__PreviousCertificates__0__Base64=
#StealthDesk_KeyProtection__PreviousCertificates__0__Password=

# ---------------------------------------------------------------- Telemetry

# With docker compose --profile telemetry, send logs, traces and metrics to the dashboard:
#StealthDesk_OTEL_EXPORTER_OTLP_ENDPOINT=http://telemetry:18889
#TELEMETRY_DASHBOARD_PORT=18888
# The token the dashboard asks for. Empty, it makes one on each start and logs a sign-in link:
# docker compose logs telemetry
#TELEMETRY_DASHBOARD_TOKEN=
