@using System.Security.Claims
@inject NavigationManager Navigation

@code {
    // The server refuses the API until a forced password change is done, so the pages send the user to do it first.
    [Parameter, EditorRequired]
    public ClaimsPrincipal User { get; set; } = default!;

    private const string ChangePage = "account/password-change-required";

    protected override void OnParametersSet()
    {
        // Already there: going again would only start another render and another navigation.
        if (User.HasClaim(ServerAuthenticationState.MustChangePasswordClaim, "true")
            && !Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith(ChangePage, StringComparison.Ordinal))
        {
            Navigation.NavigateTo(ChangePage, replace: true);
        }
    }
}
