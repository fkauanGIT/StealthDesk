@inherits LayoutComponentBase
@implements IDisposable
@inject DeviceStore Store
@inject ILiveUpdates Live
@inject SessionGuard Session
@inject AccountApi Accounts
@inject ServerAuthenticationState AuthState
@inject NavigationManager Navigation
@inject ThemeState Theme
@inject IAuthorizationService Authorization

<div class="sd-shell">
    <nav class="sd-sidebar" aria-label="Main">
        <a class="sd-brand" href="">
            <SdLogo />
            StealthDesk
        </a>
        <div class="sd-nav">
            @foreach (var section in sections)
            {
                <a class="sd-nav-link @(section == current ? "active" : null)" href="@section.Tabs[0].Href"
                   aria-current="@(section == current ? "page" : null)">
                    <SdIcon Name="section.Icon" />
                    @section.Label
                </a>
            }
        </div>

        <AuthorizeView>
            <Authorized>
                <RequirePasswordChange User="context.User" />
                <ThemePicker Compact />
                <div class="sd-user">
                    <a class="sd-user-link" href="account/manage" title="Account settings">
                        <span class="sd-avatar" aria-hidden="true">@Initials(context.User.Identity?.Name)</span>
                        <span class="sd-user-text">
                            <span class="sd-user-name">@context.User.Identity?.Name</span>
                            <span class="sd-user-role">@Role(context.User)</span>
                        </span>
                    </a>
                    <SdButton Variant="ButtonVariant.Ghost" Icon="IconName.SignOut" AriaLabel="Sign out" OnClick="SignOutAsync" />
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>

    <main class="sd-content">
        <AuthorizeView>
            <Authorized>
                <ServerAlertBanner />
            </Authorized>
        </AuthorizeView>
        @if (current is { Tabs.Count: > 1 } area)
        {
            <nav class="sd-tabs" aria-label="@area.Label">
                @foreach (var tab in area.Tabs)
                {
                    <a class="sd-tab @(tab == currentTab ? "active" : null)" href="@tab.Href" aria-current="@(tab == currentTab ? "page" : null)">@tab.Label</a>
                }
            </nav>
        }
        @Body
    </main>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    // The areas and tabs this user may open; an area with none of its pages allowed isn't shown.
    private IReadOnlyList<AppSection> sections = [];
    private AppSection? current;
    private SectionTab? currentTab;

    protected override async Task OnInitializedAsync()
    {
        Store.SessionExpired += OnSessionExpired;
        Navigation.LocationChanged += OnLocationChanged;
        AuthState.AuthenticationStateChanged += OnAuthenticationStateChanged;
        var user = AuthenticationState is null ? null : (await AuthenticationState).User;
        await ShowSectionsAsync(user);
        if (Enum.TryParse<ThemeMode>(user?.FindFirst(ServerAuthenticationState.ThemeClaim)?.Value, out var theme))
        {
            await Theme.UseAccountThemeAsync(theme);
        }
    }

    public void Dispose()
    {
        Store.SessionExpired -= OnSessionExpired;
        Navigation.LocationChanged -= OnLocationChanged;
        AuthState.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private async Task ShowSectionsAsync(System.Security.Claims.ClaimsPrincipal? user)
    {
        var visible = new List<AppSection>();
        foreach (var section in AppSections.All)
        {
            var tabs = new List<SectionTab>();
            foreach (var tab in section.Tabs)
            {
                if (tab.Policy is null || (user is not null && (await Authorization.AuthorizeAsync(user, tab.Policy)).Succeeded))
                {
                    tabs.Add(tab);
                }
            }

            if (tabs.Count > 0)
            {
                visible.Add(section with { Tabs = tabs });
            }
        }

        sections = visible;
        Locate();
    }

    private void Locate()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        current = AppSections.For(path, sections);
        currentTab = current?.TabFor(path);
    }

    // Only a new area or tab changes the menu; any other move leaves the layout as it is.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var (area, tab) = (current, currentTab);
        Locate();
        if (area != current || tab != currentTab)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> state) => InvokeAsync(async () =>
    {
        await ShowSectionsAsync((await state).User);
        StateHasChanged();
    });

    private void OnSessionExpired() => InvokeAsync(async () =>
    {
        await Live.StopAsync();
        Session.Expired();
    });

    private async Task SignOutAsync()
    {
        await Live.StopAsync();
        await Accounts.SignOutAsync();
        AuthState.MarkSignedOut();
        Navigation.NavigateTo("account/sign-in");
    }

    private static string Initials(string? email) =>
        string.IsNullOrEmpty(email) ? "?" : email[..1].ToUpperInvariant();

    private static string Role(System.Security.Claims.ClaimsPrincipal user) =>
        user.HasClaim(ServerAuthenticationState.ServerAdministratorClaim, "true") ? "Server administrator"
        : user.HasClaim(ServerAuthenticationState.TenantAdministratorClaim, "true") ? "Administrator"
        : "Member";
}
