@page "/account/password-change-required"
@attribute [Authorize]
@inject AccountApi Accounts
@inject ServerAuthenticationState AuthState
@inject NavigationManager Navigation

<PageTitle>Change your password · StealthDesk</PageTitle>

<header class="sd-auth-header">
    <h1 class="sd-auth-title">Change your password</h1>
    <p class="sd-auth-subtitle">You must replace your temporary password before continuing.</p>
</header>

@if (error is not null)
{
    <SdAlert>@error</SdAlert>
}

<form class="sd-form" @onsubmit="SubmitAsync">
    <SdTextField Label="Temporary password" Type="password" Autocomplete="current-password" @bind-Value="current" Error="@currentError" />
    <SdTextField Label="New password" Type="password" Autocomplete="new-password" @bind-Value="password" Error="@passwordError"
                 Hint="At least 8 characters, with upper and lower case letters and a digit." />
    <SdTextField Label="Confirm new password" Type="password" Autocomplete="new-password" @bind-Value="confirmation" Error="@confirmationError" />
    <SdButton Type="submit" Block="true" Disabled="busy">@(busy ? "Saving..." : "Change password")</SdButton>
</form>

<p class="sd-auth-footer"><a href="" @onclick="SignOutAsync" @onclick:preventDefault="true">Sign out</a></p>

@code {
    private string? current;
    private string? password;
    private string? confirmation;
    private bool busy;
    private string? error;
    private string? currentError;
    private string? passwordError;
    private string? confirmationError;

    private async Task SubmitAsync()
    {
        error = currentError = passwordError = confirmationError = null;
        if (string.IsNullOrEmpty(current))
        {
            currentError = "Enter your temporary password.";
            return;
        }

        if (password != confirmation)
        {
            confirmationError = "The passwords don't match.";
            return;
        }

        busy = true;
        var result = await Accounts.ChangePasswordAsync(current, password ?? string.Empty);
        busy = false;

        if (result.Succeeded)
        {
            AuthState.Refresh();
            Navigation.NavigateTo("");
            return;
        }

        currentError = FieldErrors.ForCurrentPassword(result);
        passwordError = FieldErrors.ForPassword(result);
        error = currentError is null && passwordError is null ? FieldErrors.Remaining(result) : null;
    }

    private async Task SignOutAsync()
    {
        await Accounts.SignOutAsync();
        AuthState.MarkSignedOut();
        Navigation.NavigateTo("account/sign-in");
    }
}
