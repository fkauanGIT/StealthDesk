@page "/account/sign-in"
@inject AccountApi Accounts
@inject ServerAuthenticationState AuthState
@inject NavigationManager Navigation
@inject IPasskeyBridge Passkeys
@implements IAsyncDisposable

<PageTitle>Sign in · StealthDesk</PageTitle>

<header class="sd-auth-header">
    <h1 class="sd-auth-title">Sign in to StealthDesk</h1>
    <p class="sd-auth-subtitle">Intelligent remote device management</p>
</header>

@if (Deleted && error is null)
{
    <SdAlert Tone="Tone.Info">Your account has been deleted.</SdAlert>
}

@if (error is not null)
{
    <SdAlert>
        @error
        @if (needsConfirmation)
        {
            <a href="account/resend-confirmation?email=@Uri.EscapeDataString(email ?? string.Empty)"> Send the link again</a>
        }
    </SdAlert>
}

<form class="sd-form" @onsubmit="SubmitAsync">
    @* "webauthn" lets the browser offer this site's passkeys in the field's suggestions. *@
    <SdTextField Label="Email" Type="email" Autocomplete="username webauthn" @bind-Value="email" />
    <div class="sd-field">
        <div class="sd-form-row">
            <label class="sd-label" for="password">Password</label>
            <a href="account/forgot-password" class="sd-label">Forgot password?</a>
        </div>
        <input id="password" class="sd-input" type="password" autocomplete="current-password" value="@password"
               @onchange="e => password = e.Value?.ToString()" />
    </div>
    <SdCheckbox Label="Remember me" @bind-Checked="remember" />
    <SdButton Type="submit" Block="true" Disabled="busy">@(busy ? "Signing in..." : "Sign in")</SdButton>
</form>

@if (passkeysSupported)
{
    <div class="sd-divider"><span>or</span></div>
    <SdButton Variant="ButtonVariant.Secondary" Block="true" Icon="IconName.Key" Disabled="busy" OnClick="SignInWithPasskeyAsync">Sign in with a passkey</SdButton>
}

@if (registrationOpen)
{
    <p class="sd-auth-footer">New here? <a href="account/register">Create an account</a></p>
}

@code {
    private string? email;
    private string? password;
    private bool remember = true;
    private bool busy;
    private string? error;
    private bool needsConfirmation;
    private bool registrationOpen;
    private bool passkeysSupported;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public bool Deleted { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            registrationOpen = (await Accounts.GetSettingsAsync()).RegistrationOpen;
        }
        catch (HttpRequestException)
        {
            registrationOpen = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        passkeysSupported = await Passkeys.IsSupportedAsync();
        if (passkeysSupported)
        {
            StateHasChanged();
        }

        if (await Passkeys.IsAutofillSupportedAsync())
        {
            // Waits in the background until the user picks a passkey from the email field, or leaves the page.
            _ = AutofillAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Passkeys.AbortAsync();
        }
        catch (Microsoft.JSInterop.JSDisconnectedException)
        {
            // The page is already gone.
        }
    }

    private async Task AutofillAsync()
    {
        var (options, json) = await Accounts.GetPasskeyRequestOptionsAsync();
        if (!options.Succeeded)
        {
            return;
        }

        var outcome = await Passkeys.GetAsync(json!, autofill: true);
        if (outcome.Succeeded)
        {
            await InvokeAsync(() => FinishPasskeyAsync(outcome.CredentialJson!));
        }
    }

    private async Task SignInWithPasskeyAsync()
    {
        error = null;
        busy = true;

        // The waiting autofill holds the last challenge; this sign-in asks for its own.
        await Passkeys.AbortAsync();
        var (options, json) = await Accounts.GetPasskeyRequestOptionsAsync(email);
        if (!options.Succeeded)
        {
            error = options.Error;
            busy = false;
            return;
        }

        var outcome = await Passkeys.GetAsync(json!);
        if (!outcome.Succeeded)
        {
            error = outcome.Message;
            busy = false;
            return;
        }

        await FinishPasskeyAsync(outcome.CredentialJson!);
    }

    private async Task FinishPasskeyAsync(string credentialJson)
    {
        busy = true;
        var result = await Accounts.SignInWithPasskeyAsync(credentialJson);
        busy = false;

        if (result.Succeeded)
        {
            AuthState.Refresh();
            Navigation.NavigateTo(LocalUrl.Or(ReturnUrl));
        }
        else if (result.IsLockedOut)
        {
            Navigation.NavigateTo("account/locked-out");
        }
        else
        {
            error = "This passkey isn't registered here, or the sign-in took too long. Try again or use your password.";
        }
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrEmpty(password))
        {
            error = "Enter your email and password.";
            return;
        }

        busy = true;
        error = null;
        var result = await Accounts.SignInAsync(email.Trim(), password, remember);
        busy = false;

        if (result.Succeeded)
        {
            AuthState.Refresh();
            Navigation.NavigateTo(LocalUrl.Or(ReturnUrl));
            return;
        }

        if (result.IsLockedOut)
        {
            Navigation.NavigateTo("account/locked-out");
            return;
        }

        if (result.IsTwoFactorRequired)
        {
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameters("account/sign-in/two-factor",
                new Dictionary<string, object?> { ["rememberMe"] = remember ? "true" : null, ["returnUrl"] = ReturnUrl }));
            return;
        }

        needsConfirmation = result.IsNotAllowed;
        error = result.Error;
    }
}
