@page "/devices/add"
@page "/deploy"
@implements IDisposable
@attribute [Authorize(Policy = PermissionPolicies.Prefix + PermissionNames.AgentInstall)]
@using StealthDesk.Contracts.InstallerKeys
@using StealthDesk.Web.Client.InstallerKeys
@inject InstallerKeyApi Api
@inject SessionGuard Session
@inject IJSRuntime Js
@inject IAuthorizationService Authorization
@inject NavigationManager Navigation
@inject TimeProvider Clock
@inject DeviceStore Devices
@inject StealthDesk.Web.Client.TenantSettings.TenantSettingApi Settings
@inject StealthDesk.Web.Client.DeviceGroups.DeviceGroupApi DeviceGroups

<PageTitle>Add a device · StealthDesk</PageTitle>

<a class="sd-back" href="">
    <SdIcon Name="IconName.Back" Size="16" />
    Devices
</a>
<header class="sd-page-header">
    <h1 class="sd-page-title">Add a device</h1>
</header>

<ol class="sd-progress" aria-label="Steps">
    <li class="@StepClass(1)" aria-current="@(Step == 1 ? "step" : null)">Choose a key</li>
    <li class="@StepClass(2)" aria-current="@(Step == 2 ? "step" : null)">Install the agent</li>
    <li class="@StepClass(3)" aria-current="@(Step == 3 ? "step" : null)">Device joins</li>
</ol>

@if (error is not null)
{
    <SdAlert>@error</SdAlert>
}

@if (fullKey is null)
{
    <SdCard Title="Installer key">
        <p class="sd-muted">An agent joins with an installer key, and the device belongs to this tenant. Create a key or use one you kept.</p>
        @if (canCreate)
        {
            <SdSegmented TValue="KeySource" Label="Key" Options="Sources" @bind-Value="source" />
        }

        @if (source == KeySource.New && canCreate)
        {
            <form class="sd-deploy-form" @onsubmit="CreateAsync" @onsubmit:preventDefault>
                <SdSegmented TValue="InstallerKeyType" Label="Type" Options="Types" @bind-Value="type" />
                <p class="sd-field-hint" data-type-hint>@TypeHint</p>
                <SdTextField Label="Name (optional)" Placeholder="Where it's used, e.g. Front desk PCs" Autocomplete="off" @bind-Value="name" />
                @if (groupOptions.Count > 1)
                {
                    <SdSelect Label="Device group (optional)" Options="groupOptions" @bind-Value="groupChoice" />
                }
                @if (type == InstallerKeyType.UsageBased)
                {
                    <SdTextField Label="Uses" Type="number" min="1" @bind-Value="uses" />
                }
                else if (type == InstallerKeyType.TimeBased)
                {
                    <SdTextField Label="Expires" Type="datetime-local" @bind-Value="expires" />
                }
                @if (createError is not null)
                {
                    <SdAlert>@createError</SdAlert>
                }
                <div>
                    <SdButton Type="submit" Icon="IconName.Key" Disabled="busy">@(busy ? "Creating..." : "Create key")</SdButton>
                </div>
            </form>
        }
        else
        {
            <form class="sd-deploy-form" @onsubmit="UseExisting" @onsubmit:preventDefault>
                @if (existing is null)
                {
                    <SdLoading Text="Loading keys..." />
                }
                else if (existing.Count == 0)
                {
                    <p class="sd-muted">There are no keys you can use. @(canCreate ? "Create a new one instead." : "Ask someone who manages installer keys for one.")</p>
                }
                else
                {
                    <SdSelect Label="Key" Options="ExistingOptions" @bind-Value="selected" />
                    <SdTextField Label="Key or secret" Type="password" Autocomplete="off"
                                 Hint="The key shown when it was created; it is never shown again." @bind-Value="pasted" Error="@pasteError" />
                    <div>
                        <SdButton Type="submit" Icon="IconName.Key">Use this key</SdButton>
                    </div>
                }
            </form>
        }
    </SdCard>
}
else
{
    <SdCard Title="Install the agent">
        @if (windowsAgent is not null)
        {
            <p class="sd-muted" data-download-instructions>Run this in PowerShell as an administrator on the machine. It downloads the agent from this server, runs it only if it is the expected build, and installs it as a service that starts with Windows. Running it again updates an installed agent.</p>
        }
        else
        {
            <div data-no-download>
                <SdAlert Tone="Tone.Warning">
                    This server has no agent build to hand out. Copy @AgentFileName to the machine, then run this in PowerShell as an administrator from its folder.
                </SdAlert>
            </div>
        }
        @if (keyInUse is { } key)
        {
            <SdAlert Tone="Tone.Info">@Limits(key)</SdAlert>
        }
        <div class="sd-deploy-form">
            <SdTextField Label="Device ID (optional)" Placeholder="Leave empty for a new random ID" Autocomplete="off"
                         Hint="Each install needs its own ID; give one only to reinstall a known device." @bind-Value="deviceId" Error="@DeviceIdError" />
        </div>
        <code class="sd-secret" data-command>@Command</code>
        <div class="sd-actions">
            <SdButton Icon="IconName.Copy" Disabled="DeviceIdError is not null" OnClick="CopyAsync">@(copied ? "Copied" : "Copy command")</SdButton>
            <SdButton Variant="ButtonVariant.Secondary" OnClick="StartOver">Use another key</SdButton>
        </div>
        <details class="sd-disclosure">
            <summary>Running the agent from its source code instead</summary>
            <p class="sd-muted">From the repository folder; development agents already point at the local server.</p>
            <code class="sd-secret" data-source-command>@SourceCommand</code>
        </details>
        @if (justCreated)
        {
            <SdAlert Tone="Tone.Warning">
                Save the key now if you'll install more agents with it later: it is never shown again.
                <code class="sd-secret" data-key>@fullKey</code>
            </SdAlert>
        }
    </SdCard>

    <SdCard Title="Device joins">
        @if (joined is { } device)
        {
            <div class="sd-joined" role="status" data-joined>
                <DeviceStatus IsOnline="device.IsOnline" />
                <span><strong>@device.Name</strong> joined.</span>
                <a class="sd-btn sd-btn--primary" href="@($"devices/{device.Id}")">Open device</a>
            </div>
        }
        else
        {
            <div class="sd-waiting" role="status" data-waiting>
                <span class="sd-pulse" aria-hidden="true"></span>
                Waiting for the device to report. It shows up here as soon as the agent connects.
            </div>
        }
    </SdCard>
}

@code {
    private enum KeySource
    {
        New,
        Existing,
    }

    private static readonly string WritePolicy = PermissionPolicies.For(PermissionNames.InstallerKeyWrite);

    private static readonly IReadOnlyList<(KeySource, string)> Sources = [(KeySource.New, "New key"), (KeySource.Existing, "Existing key")];

    private static readonly IReadOnlyList<(InstallerKeyType, string)> Types =
        [.. new[] { InstallerKeyType.UsageBased, InstallerKeyType.TimeBased, InstallerKeyType.Persistent }.Select(x => (x, InstallerKeyText.Type(x)))];

    private KeySource source = KeySource.New;
    private InstallerKeyType type = InstallerKeyType.UsageBased;
    private string? name;
    private string? uses = "1";
    private string? expires;
    private IReadOnlyList<InstallerKey>? existing;
    private string? selected;
    private string? pasted;
    private string? fullKey;
    private InstallerKey? keyInUse;
    private string? deviceId;
    private bool canCreate;
    private string? instance;
    private StealthDesk.Contracts.Agents.AgentDownload? windowsAgent;
    private IReadOnlyList<SelectOption> groupOptions = [];
    private string? groupChoice = string.Empty;
    private DeviceSummary? joined;
    private HashSet<Guid> knownBefore = [];
    private DateTimeOffset watchingSince;
    private CancellationTokenSource? watching;
    private bool justCreated;
    private bool copied;
    private bool busy;
    private string? error;
    private string? createError;
    private string? pasteError;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private string TypeHint => type switch
    {
        InstallerKeyType.UsageBased => $"Works for a number of installs, within {InstallerKeyRules.UsageBasedLifetime.TotalHours:0} hours.",
        InstallerKeyType.TimeBased => "Works for any number of installs until it expires.",
        _ => "Works until it is revoked. Keep it as safe as a password.",
    };

    private IReadOnlyList<SelectOption> ExistingOptions =>
        [.. (existing ?? []).Select(x => new SelectOption(x.Id.ToString(), $"{x.Name ?? "Unnamed"} · {InstallerKeyText.Type(x.Type)}"))];

    private string? DeviceIdError =>
        string.IsNullOrWhiteSpace(deviceId) || Guid.TryParse(deviceId.Trim(), out var id) && id != Guid.Empty ? null : "Enter a device ID like 3f2504e0-4f89-11d3-9a0c-0305e82c3301, or leave it empty.";

    private int Step => fullKey is null ? 1 : joined is null ? 2 : 3;

    private string? StepClass(int step) => step < Step ? "done" : step == Step ? "current" : null;

    private Guid? RequestedId => Guid.TryParse(deviceId?.Trim(), out var id) && id != Guid.Empty ? id : null;

    private string SourceCommand => InstallerKeyText.SourceCommand(fullKey!, RequestedId, instance);

    private const string AgentFileName = "StealthDesk.Agent.exe";

    // With a build to hand out, the command fetches and checks it; without one, it runs an agent copied by hand.
    private string Command => windowsAgent is not null
        ? StealthDesk.Contracts.Agents.AgentInstallCommand.Windows(new Uri(Navigation.BaseUri), windowsAgent, fullKey!, RequestedId, instance)
        : InstallerKeyText.AgentCommand(new Uri(Navigation.BaseUri), fullKey!, RequestedId, instance);

    protected override async Task OnInitializedAsync()
    {
        expires = Clock.GetLocalNow().AddDays(1).ToString("yyyy-MM-ddTHH:mm");
        if (AuthenticationState is not null)
        {
            canCreate = (await Authorization.AuthorizeAsync((await AuthenticationState).User, WritePolicy)).Succeeded;
        }

        source = canCreate ? KeySource.New : KeySource.Existing;
        await LoadExistingAsync();

        // The tenant may name an agent instance, and the server may hand out the agent; without its options the
        // commands name no instance and run an agent copied by hand.
        var options = (await Settings.DeploymentOptionsAsync()).Value;
        instance = options?.InstanceName;
        windowsAgent = options?.WindowsAgent;

        // New devices can join a group, for whoever may read the groups; the server checks they may fill it.
        var user = AuthenticationState is null ? null : (await AuthenticationState).User;
        if (canCreate && user is not null
            && (await Authorization.AuthorizeAsync(user, PermissionPolicies.For(PermissionNames.TenantDeviceGroupsRead))).Succeeded
            && Guid.TryParse(user.FindFirst(ServerAuthenticationState.TenantIdClaim)?.Value, out var tenant)
            && (await DeviceGroups.ListAsync(tenant)).Value is { } groups)
        {
            groupOptions = [new(string.Empty, "No group"), .. groups.Items.Select(x => new SelectOption(x.Id.ToString(), x.Name))];
        }
    }

    private async Task LoadExistingAsync()
    {
        var result = await Api.ListAsync();
        if (Expired(result.SessionExpired))
        {
            return;
        }

        existing = result.Value?.Items ?? [];
        selected = existing.FirstOrDefault()?.Id.ToString();
        if (!result.Succeeded && !canCreate)
        {
            error = result.Error;
        }
    }

    private async Task CreateAsync()
    {
        createError = null;
        int? allowedUses = null;
        DateTimeOffset? expiresAt = null;
        if (type == InstallerKeyType.UsageBased)
        {
            if (!int.TryParse(uses, out var count) || count < 1)
            {
                createError = "Enter how many installs the key allows, at least 1.";
                return;
            }

            allowedUses = count;
        }
        else if (type == InstallerKeyType.TimeBased)
        {
            if (!DateTime.TryParse(expires, out var local))
            {
                createError = "Choose when the key expires.";
                return;
            }

            expiresAt = new DateTimeOffset(DateTime.SpecifyKind(local, DateTimeKind.Local));
        }

        busy = true;
        var result = await Api.CreateAsync(new CreateInstallerKeyRequest(
            type,
            string.IsNullOrWhiteSpace(name) ? null : name.Trim(),
            allowedUses,
            expiresAt,
            Guid.TryParse(groupChoice, out var group) ? group : null));
        busy = false;
        if (Expired(result.SessionExpired))
        {
            return;
        }

        if (!result.Succeeded || result.Value is not { } created)
        {
            createError = result.Error;
            return;
        }

        fullKey = created.FullKey;
        await WatchAsync();
        keyInUse = created.Key;
        justCreated = true;
        copied = false;
    }

    private void UseExisting()
    {
        pasteError = null;
        var key = existing?.FirstOrDefault(x => x.Id.ToString() == selected);
        var value = pasted?.Trim();
        if (key is null || string.IsNullOrEmpty(value))
        {
            pasteError = "Paste the key or its secret.";
            return;
        }

        if (value.Contains(':'))
        {
            if (!value.StartsWith($"{key.Id}:", StringComparison.OrdinalIgnoreCase))
            {
                pasteError = "That key isn't the one selected.";
                return;
            }
        }
        else
        {
            value = $"{key.Id}:{value}";
        }

        fullKey = value;
        _ = WatchAsync();
        keyInUse = key;
        justCreated = false;
        copied = false;
        pasted = null;
    }

    private async Task StartOver()
    {
        StopWatching();
        joined = null;
        fullKey = null;
        keyInUse = null;
        deviceId = null;
        justCreated = false;
        copied = false;
        await LoadExistingAsync();
    }

    private async Task CopyAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", Command);
            copied = true;
        }
        catch (JSException)
        {
            error = "The browser didn't allow copying. Select the command and copy it yourself.";
        }
    }

    private string Limits(InstallerKey key) => key.Type switch
    {
        InstallerKeyType.UsageBased => $"This key installs {key.AllowedUses} agent{(key.AllowedUses == 1 ? string.Empty : "s")} in all, until {Date(key.ExpiresAt)}.",
        InstallerKeyType.TimeBased => $"This key works until {Date(key.ExpiresAt)}.",
        _ => "This key works until it is revoked.",
    } + (key.DeviceGroupName is { } group ? $" New devices join the group {group}." : string.Empty);

    private static string Date(DateTimeOffset? value) => value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "it is revoked";

    // The page waits for the device the command brings: one it hadn't seen before, or the one asked for by id
    // reporting after the command was shown. Asked every few seconds; new devices aren't pushed to a page yet.
    private async Task WatchAsync()
    {
        StopWatching();
        watching = new CancellationTokenSource();
        var token = watching.Token;
        watchingSince = Clock.GetUtcNow();
        await Devices.LoadAsync();
        knownBefore = [.. Devices.Devices?.Select(x => x.Id) ?? []];
        _ = PollAsync(token);
    }

    private async Task PollAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3), Clock);
        try
        {
            while (joined is null && await timer.WaitForNextTickAsync(token))
            {
                await Devices.LoadAsync();
                joined = Devices.Devices?.FirstOrDefault(x =>
                    !knownBefore.Contains(x.Id) || (x.Id == RequestedId && x.IsOnline && x.LastSeen >= watchingSince));
                if (joined is not null)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StopWatching()
    {
        watching?.Cancel();
        watching?.Dispose();
        watching = null;
    }

    public void Dispose() => StopWatching();

    private bool Expired(bool sessionExpired)
    {
        if (sessionExpired)
        {
            Session.Expired();
        }

        return sessionExpired;
    }
}
