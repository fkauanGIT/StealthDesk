@page "/"
@implements IDisposable
@inject DeviceStore Store
@inject ILiveUpdates Live

<PageTitle>Devices</PageTitle>

<div class="d-flex align-items-center gap-3 mb-3">
    <h1 class="mb-0">Devices</h1>
    @switch (Live.State)
    {
        case LiveState.Live:
            <span class="badge text-bg-success live-indicator">Live</span>
            break;
        case LiveState.Reconnecting:
            <span class="badge text-bg-warning live-indicator">Reconnecting...</span>
            break;
        default:
            <span class="badge text-bg-secondary live-indicator">Connecting...</span>
            break;
    }
</div>

@if (Store.Error is not null)
{
    <div class="alert alert-danger">@Store.Error</div>
}

@if (Store.Devices is null)
{
    @if (Store.Error is null)
    {
        <p>Loading devices...</p>
    }
}
else if (Store.Devices.Count == 0)
{
    <p>No devices yet. Run the agent on a machine and it will show up here.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>OS</th>
                <th>CPU</th>
                <th>Memory</th>
                <th>Storage</th>
                <th>Users</th>
                <th>Status</th>
                <th>Last seen</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var device in Store.Devices)
            {
                <tr @key="device.Id">
                    <td>@device.Name</td>
                    <td>@device.OsDescription</td>
                    <td>@device.CpuLoad.ToString("P0")</td>
                    <td>@Usage(device.MemoryUsedGb, device.MemoryTotalGb)</td>
                    <td>@Usage(device.StorageUsedGb, device.StorageTotalGb)</td>
                    <td>@string.Join(", ", device.LoggedOnUsers)</td>
                    <td>
                        @if (device.IsOnline)
                        {
                            <span class="badge text-bg-success">Online</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Offline</span>
                        }
                    </td>
                    <td>@device.LastSeen.ToLocalTime().ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Store.Changed += Refresh;
        Live.StateChanged += Refresh;

        // Listening starts before loading, so no change can fall between the two.
        _ = Live.StartAsync();
        await Store.LoadAsync();
    }

    public void Dispose()
    {
        Store.Changed -= Refresh;
        Live.StateChanged -= Refresh;
    }

    // Changes arrive outside the page's own events, so the page is told to render again.
    private void Refresh() => InvokeAsync(StateHasChanged);

    private static string Usage(double usedGb, double totalGb) =>
        totalGb > 0 ? $"{usedGb:0.#} / {totalGb:0.#} GB ({usedGb / totalGb:P0})" : "-";
}
