@page "/permissions"
@attribute [Authorize(Policy = PermissionPolicies.Prefix + PermissionNames.TenantPermissionsRead)]
@using StealthDesk.Contracts.PersonalAccessTokens
@using StealthDesk.Web.Client.Permissions
@using StealthDesk.Web.Client.PersonalAccessTokens
@using StealthDesk.Web.Client.ServiceAccounts
@using StealthDesk.Web.Client.UserGroups
@using StealthDesk.Web.Client.Users
@inject UserApi Users
@inject UserGroupApi Groups
@inject PersonalAccessTokenApi Tokens
@inject ServiceAccountApi ServiceAccounts
@inject IAuthorizationService Authorization
@inject SessionGuard Session
@inject NavigationManager Navigation

<PageTitle>Permissions · StealthDesk</PageTitle>

<header class="sd-page-header">
    <h1 class="sd-page-title">Permissions</h1>
</header>
<p class="sd-muted sd-page-lead">What a user, user group, service account or one of your access tokens may do, where, and why. A deny always wins over an allow.</p>

<div class="sd-permission-picker">
    <SdSegmented TValue="PermissionPrincipalKind" Label="Grant to" Options="Kinds" Value="kind" ValueChanged="KindChangedAsync" />
    @if (principals is null)
    {
        @if (pickerError is null)
        {
            <SdLoading Text="Loading..." />
        }
        else
        {
            <SdAlert>@pickerError</SdAlert>
        }
    }
    else
    {
        <SdSelect Label="@KindText(kind)" Options="principals"
                  Value="@principalId?.ToString()" ValueChanged="PrincipalChanged" />
    }
</div>

@if (principalId is { } id)
{
    <PermissionAssignmentsPanel @key="(kind, id)" TenantId="tenantId" Kind="kind" PrincipalId="id" />
}

@code {
    private static readonly IReadOnlyList<(PermissionPrincipalKind, string)> Kinds =
        [
            (PermissionPrincipalKind.User, "User"),
            (PermissionPrincipalKind.UserGroup, "User group"),
            (PermissionPrincipalKind.ServiceAccount, "Service account"),
            (PermissionPrincipalKind.PersonalAccessToken, "Access token"),
        ];

    private PermissionPrincipalKind kind = PermissionPrincipalKind.User;
    private Guid? principalId;
    private IReadOnlyList<SelectOption>? principals;
    private string? pickerError;
    private Guid tenantId;

    /// <summary>Opened from a user or group: who to show first.</summary>
    [SupplyParameterFromQuery(Name = "kind")]
    public string? KindQuery { get; set; }

    [SupplyParameterFromQuery(Name = "id")]
    public Guid? IdQuery { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var user = AuthenticationState is null ? null : (await AuthenticationState).User;
        _ = Guid.TryParse(user?.FindFirst(ServerAuthenticationState.TenantIdClaim)?.Value, out tenantId);
        kind = Enum.TryParse<PermissionPrincipalKind>(KindQuery, out var asked) && Kinds.Any(x => x.Item1 == asked)
            ? asked
            : PermissionPrincipalKind.User;
        principalId = IdQuery;
        await LoadPrincipalsAsync();
    }

    private async Task KindChangedAsync(PermissionPrincipalKind value)
    {
        kind = value;
        principalId = null;
        await LoadPrincipalsAsync();
    }

    private void PrincipalChanged(string? value)
    {
        principalId = Guid.TryParse(value, out var id) ? id : null;
        Navigation.NavigateTo($"permissions?kind={kind}&id={principalId}", replace: true);
    }

    // Picking someone needs to see them: the tenant's users, groups or service accounts (and the server's for whoever
    // may see those), or the tokens of whoever is signed in.
    private async Task LoadPrincipalsAsync()
    {
        principals = null;
        pickerError = null;
        List<SelectOption>? options = null;
        bool expired;
        if (kind == PermissionPrincipalKind.User)
        {
            var (list, result) = await Users.ListAsync(tenantId);
            expired = result.SessionExpired;
            options = list?.Items.Select(x => new SelectOption(x.Id.ToString(), x.Email ?? x.UserName)).ToList();
        }
        else if (kind == PermissionPrincipalKind.UserGroup)
        {
            var result = await Groups.ListAsync(tenantId);
            expired = result.SessionExpired;
            options = result.Value?.Items.Select(x => new SelectOption(x.Id.ToString(), x.Name)).ToList();
        }
        else if (kind == PermissionPrincipalKind.ServiceAccount)
        {
            var result = await ServiceAccounts.ListAsync(tenantId);
            expired = result.SessionExpired;
            options = result.Value?.Items.Select(x => new SelectOption(x.Id.ToString(), x.Name)).ToList();
            if (options is not null && await HoldsAsync(PermissionNames.ServerServiceAccountsRead))
            {
                var server = await ServiceAccounts.ListAsync(null);
                expired |= server.SessionExpired;
                options.AddRange(server.Value?.Items.Select(x => new SelectOption(x.Id.ToString(), $"{x.Name} · server")) ?? []);
            }
        }
        else
        {
            var result = await Tokens.ListAsync();
            expired = result.SessionExpired;
            options = result.Value?.Items.Select(x => new SelectOption(x.Id.ToString(), TokenText(x))).ToList();
        }

        if (expired)
        {
            Session.Expired();
            return;
        }

        if (options is null)
        {
            pickerError = kind switch
            {
                PermissionPrincipalKind.User => "Your account can't list the tenant's users.",
                PermissionPrincipalKind.UserGroup => "Your account can't list the tenant's user groups.",
                PermissionPrincipalKind.ServiceAccount => "Your account can't list the tenant's service accounts.",
                _ => "Your account can't list its access tokens.",
            };
            return;
        }

        var placeholder = kind switch
        {
            PermissionPrincipalKind.User => "Choose a user",
            PermissionPrincipalKind.UserGroup => "Choose a user group",
            PermissionPrincipalKind.ServiceAccount => "Choose a service account",
            _ => "Choose an access token",
        };
        principals = [new SelectOption(string.Empty, placeholder), .. options];
    }

    private static string KindText(PermissionPrincipalKind value) => Kinds.First(x => x.Item1 == value).Item2;

    private async Task<bool> HoldsAsync(string permission) =>
        AuthenticationState is not null
        && (await Authorization.AuthorizeAsync((await AuthenticationState).User, PermissionPolicies.For(permission))).Succeeded;

    // An inheriting token takes its owner's permissions, so anything granted to it has no effect.
    private static string TokenText(PersonalAccessTokenSummary token) =>
        token.Mode == PersonalAccessTokenMode.InheritOwner ? $"{token.Name} (inherits your permissions)" : token.Name;
}
