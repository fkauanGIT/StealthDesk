<button type="@Type" class="@CssClass" disabled="@Disabled" aria-label="@AriaLabel" @onclick="OnClick" @attributes="AdditionalAttributes">
    @if (Icon is { } icon)
    {
        <SdIcon Name="icon" />
    }
    @ChildContent
</button>

@code {
    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;

    [Parameter]
    public string Type { get; set; } = "button";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Block { get; set; }

    [Parameter]
    public IconName? Icon { get; set; }

    /// <summary>Required when the button shows only an icon.</summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass =>
        $"sd-btn sd-btn--{Variant.ToString().ToLowerInvariant()}"
        + (ChildContent is null && Icon is not null ? " sd-btn--icon" : "")
        + (Block ? " sd-btn--block" : "");
}
