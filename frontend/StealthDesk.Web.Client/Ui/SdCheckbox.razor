<label class="sd-checkbox">
    <input type="checkbox" checked="@Checked" disabled="@Disabled" @onchange="Changed" />
    @Label
</label>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public bool Checked { get; set; }

    [Parameter]
    public EventCallback<bool> CheckedChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private Task Changed(ChangeEventArgs e) => CheckedChanged.InvokeAsync(e.Value is true);
}
