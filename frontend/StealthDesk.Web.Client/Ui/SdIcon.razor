@* Stroke icons drawn in the current text color. Decorative unless the parent labels them. *@
<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="@Class">
    @switch (Name)
    {
        case IconName.Device:
            <rect x="3" y="4" width="18" height="12" rx="2"></rect>
            <path d="M8 20h8"></path>
            <path d="M12 16v4"></path>
            break;
        case IconName.Account:
            <circle cx="12" cy="8" r="4"></circle>
            <path d="M4 21c1.5-4 5-6 8-6s6.5 2 8 6"></path>
            break;
        case IconName.Search:
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M20 20l-3.5-3.5"></path>
            break;
        case IconName.Refresh:
            <path d="M21 12a9 9 0 1 1-2.64-6.36"></path>
            <path d="M21 3v6h-6"></path>
            break;
        case IconName.SignOut:
            <path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3"></path>
            <path d="M10 17l-5-5 5-5"></path>
            <path d="M5 12h11"></path>
            break;
        case IconName.Back:
            <path d="M15 18l-6-6 6-6"></path>
            break;
        case IconName.Alert:
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 8v5"></path>
            <path d="M12 16h.01"></path>
            break;
        case IconName.Close:
            <path d="M6 6l12 12"></path>
            <path d="M18 6L6 18"></path>
            break;
        case IconName.Mail:
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="M3 7l9 6 9-6"></path>
            break;
        case IconName.Lock:
            <rect x="5" y="11" width="14" height="10" rx="2"></rect>
            <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
            break;
        case IconName.Link:
            <path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"></path>
            <path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"></path>
            break;
        case IconName.Key:
            <circle cx="8" cy="15" r="4"></circle>
            <path d="M10.8 12.2L20 3"></path>
            <path d="M17 6l3 3"></path>
            <path d="M15 8l2 2"></path>
            break;
        case IconName.Shield:
            <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"></path>
            <path d="M9 12l2 2 4-4"></path>
            break;
        case IconName.ChevronDown:
            <path d="M6 9l6 6 6-6"></path>
            break;
        case IconName.ChevronUp:
            <path d="M6 15l6-6 6 6"></path>
            break;
        case IconName.History:
            <path d="M3 12a9 9 0 1 0 3-6.7"></path>
            <path d="M3 4v5h5"></path>
            <path d="M12 8v4l3 2"></path>
            break;
        case IconName.Copy:
            <rect x="9" y="9" width="11" height="11" rx="2"></rect>
            <path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
            break;
        case IconName.Users:
            <circle cx="9" cy="8" r="3.5"></circle>
            <path d="M2.5 20c1-3.5 3.8-5.5 6.5-5.5s5.5 2 6.5 5.5"></path>
            <path d="M16 4.5a3.5 3.5 0 0 1 0 7"></path>
            <path d="M18 14.8c1.7.6 3 2.4 3.5 5.2"></path>
            break;
        case IconName.Download:
            <path d="M12 4v11"></path>
            <path d="M7 10l5 5 5-5"></path>
            <path d="M5 20h14"></path>
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public IconName Name { get; set; }

    [Parameter]
    public int Size { get; set; } = 18;

    [Parameter]
    public string? Class { get; set; }
}
